<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android-only to keep the build self-contained (no iOS/Mac/Windows workloads needed). -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>FootballManagerSimulator.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Disable MAUI CSS handling so Blazor can handle it -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Pocket Gaffer</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.jordanneil.pocketgaffer</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.7</ApplicationDisplayVersion>
        <ApplicationVersion>10</ApplicationVersion>

        <!-- Partial trimming keeps our assemblies intact so reflection-based DI
             (NetCore.AutoRegisterDi) and Newtonsoft.Json TypeNameHandling work at runtime. -->
        <TrimMode>partial</TrimMode>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

        <!-- Include 32-bit ARM: Fire tablets (e.g. Fire HD 8) run a 32-bit OS and are otherwise marked incompatible. -->
        <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- Debug builds default to Fast Deployment, which leaves the .NET assemblies out of the APK, so a
         hand-installed debug APK crashes on launch. Embed them so the APK is self-contained. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0e1116" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0e1116" BaseSize="128,128" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NetCore.AutoRegisterDi" Version="2.2.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FootballManagerSimulator.PlayerGenerator\FootballManagerSimulator.PlayerGenerator.csproj" />
    </ItemGroup>

    <ItemGroup>
      <MauiAsset Update="Resources\Raw\settings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </MauiAsset>
    </ItemGroup>

</Project>
