@inject GameEngine Engine

<div class="lineups">
    <div class="lineup home">
        @if (ShowTeamNames) { <h3>@Fixture.HomeClub.Name</h3> }
        @RenderSide(Engine.GetClub(Fixture.HomeClub.Id)?.TacticSlots, Fixture.HomeScorers, Fixture.HomeCards, false)
    </div>
    <div class="lineup away">
        @if (ShowTeamNames) { <h3>@Fixture.AwayClub.Name</h3> }
        @RenderSide(Engine.GetClub(Fixture.AwayClub.Id)?.TacticSlots, Fixture.AwayScorers, Fixture.AwayCards, true)
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FixtureModel Fixture { get; set; } = default!;
    [Parameter] public bool ShowScorers { get; set; }
    [Parameter] public bool ShowMinutes { get; set; } = true;
    [Parameter] public bool ShowTeamNames { get; set; } = true;
    [Parameter] public int? LiveMinute { get; set; }

    private RenderFragment RenderSide(List<TacticSlotModel>? slots, List<GoalModel> scorers, List<CardModel> cards, bool away) => builder =>
    {
        if (slots == null) return;
        var seq = 0;
        var subs = slots.Where(s => s.TacticSlotType == TacticSlotType.SUB).ToList();
        var toRender = slots.Take(11).Concat(subs).ToList();

        for (var i = 0; i < toRender.Count; i++)
        {
            if (i == 11)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "lineup-sep");
                builder.CloseElement();
            }

            var slot = toRender[i];
            var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", player == null ? "lineup-row empty" : "lineup-row");

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "shirt");
            builder.AddContent(seq++, player?.ShirtNumber?.ToString() ?? "");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, player != null ? Surname(player.Name) : "Empty slot");
            builder.CloseElement();

            if (ShowScorers && player != null)
            {
                var filteredScorers = LiveMinute.HasValue
                    ? scorers.Where(s => s.PlayerId == player.Id && s.Minute <= LiveMinute.Value)
                    : scorers.Where(s => s.PlayerId == player.Id);

                var goalList = filteredScorers.ToList();
                if (goalList.Any())
                {
                    builder.OpenElement(seq++, "span");
                    builder.AddAttribute(seq++, "class", "scorer");
                    builder.AddContent(seq++, ShowMinutes
                        ? "⚽ " + string.Join(", ", goalList.Select(s => $"{s.Minute}'"))
                        : string.Join(" ", goalList.Select(_ => "⚽")));
                    builder.CloseElement();
                }

                var cardList = cards
                    .Where(c => c.PlayerId == player.Id && (!LiveMinute.HasValue || c.Minute <= LiveMinute.Value))
                    .OrderBy(c => c.Minute)
                    .ToList();
                if (cardList.Any())
                {
                    builder.OpenElement(seq++, "span");
                    builder.AddAttribute(seq++, "class", "scorer");
                    builder.AddContent(seq++, string.Join(" ", cardList.Select(c =>
                        (c.IsRed ? "🟥" : "🟨") + (ShowMinutes ? $" {c.Minute}'" : ""))));
                    builder.CloseElement();
                }
            }

            builder.CloseElement();
        }
    };

    private static string Surname(string name)
    {
        var parts = name.Split(' ');
        return parts.Length > 1 ? parts[^1] : name;
    }
}
