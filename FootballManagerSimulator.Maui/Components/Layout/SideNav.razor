@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<nav class="sidenav">
    <NavItem Href="/game" Icon="🏠" Label="Hub" Badge="@(Engine.UnreadNotificationCount > 0 ? Engine.UnreadNotificationCount.ToString() : null)" />
    <NavItem Href="@($"/club/{Engine.MyClub.Id}")" Icon="👕" Label="My Club" />
    <NavItem Href="/tactics" Icon="♟️" Label="Tactics" />
    <NavItem Href="/league-table" Icon="📊" Label="League Table" />
    <NavItem Href="/fixtures" Icon="📅" Label="Fixtures" />
    <NavItem Href="/scout" Icon="🔍" Label="Scout" />
    <NavItem Href="/transfers" Icon="💷" Label="Transfer List" />
    <NavItem Href="/finances" Icon="🏦" Label="Finances" />

    <div class="sidenav-spacer"></div>

    <NavItem Href="/settings" Icon="⚙️" Label="Settings" />
    <NavItem Href="/save" Icon="💾" Label="Save Game" />
    <a class="nav-item nav-item-quit" @onclick="ShowQuitModal" @onclick:preventDefault>
        <span class="nav-icon">⏏️</span><span class="nav-label">Main Menu</span>
    </a>
</nav>

<ConfirmModal Visible="_showQuitModal"
              Title="Return to Main Menu?"
              Message="Any unsaved progress will be lost."
              OnConfirm="ConfirmQuit"
              OnCancel="HideQuitModal" />

@code {
    private bool _showQuitModal;

    protected override void OnInitialized() => Engine.Changed += OnChanged;
    public void Dispose() => Engine.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ShowQuitModal() => _showQuitModal = true;
    private void HideQuitModal() => _showQuitModal = false;
    private void ConfirmQuit()
    {
        _showQuitModal = false;
        Nav.NavigateTo("/");
    }
}
