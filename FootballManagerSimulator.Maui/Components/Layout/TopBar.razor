@inject GameEngine Engine
@implements IDisposable

<header class="topbar">
    <div class="topbar-club">
        <span class="crest" style="@CrestStyle(Engine.MyClub.Colour)">🛡️</span>
        <div>
            <div class="topbar-club-name">@Engine.MyClub.Name</div>
            <div class="topbar-manager">@Engine.State.ManagerName</div>
        </div>
    </div>

    <div class="topbar-next">@Engine.NextMatchCaption()</div>

    <div class="topbar-meta">
        <div class="topbar-date">@Engine.State.DateFriendly</div>
        <div class="topbar-weather">@WeatherIcon(Engine.State.Weather) @Engine.State.Weather</div>
    </div>
</header>

@code {
    protected override void OnInitialized() => Engine.Changed += OnChanged;
    public void Dispose() => Engine.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string WeatherIcon(string? weather) => (weather ?? "").ToLower() switch
    {
        var w when w.Contains("sun") || w.Contains("clear") => "☀️",
        var w when w.Contains("rain") => "🌧️",
        var w when w.Contains("snow") => "❄️",
        var w when w.Contains("cloud") || w.Contains("overcast") => "☁️",
        var w when w.Contains("wind") => "🌬️",
        var w when w.Contains("storm") || w.Contains("thunder") => "⛈️",
        _ => "🌤️"
    };

    private static readonly Dictionary<string, string> ColourMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Red"] = "#d32f2f",
        ["Blue"] = "#1565c0",
        ["White"] = "#e8e8e8",
        ["Black"] = "#1a1a1a",
        ["Yellow"] = "#f9a825",
        ["Green"] = "#2e7d32",
        ["Navy"] = "#1a237e",
        ["Sky Blue"] = "#4fc3f7",
        ["Light Blue"] = "#4fc3f7",
        ["Claret"] = "#7b1f3a",
        ["Maroon"] = "#7b1f3a",
        ["Amber"] = "#ff8f00",
        ["Gold"] = "#ffc107",
        ["Orange"] = "#e65100",
        ["Tangerine"] = "#ff6d00",
        ["Purple"] = "#7b1fa2",
    };

    private static string ToHex(string name) =>
        ColourMap.TryGetValue(name.Trim(), out var hex) ? hex : "#15c47e";

    private static bool IsLight(string hex)
    {
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
    }

    private static string CrestStyle(string colour)
    {
        if (string.IsNullOrWhiteSpace(colour))
            return "";

        var parts = colour.Split('/');
        if (parts.Length == 1)
        {
            var hex = ToHex(parts[0]);
            var textCol = IsLight(hex) ? "#111" : "#fff";
            return $"background:{hex};color:{textCol}";
        }

        var hexes = parts.Select(p => ToHex(p)).ToArray();
        var stripeWidth = 6;
        var stops = new List<string>();
        for (var i = 0; i < hexes.Length; i++)
        {
            var start = i * stripeWidth;
            var end = (i + 1) * stripeWidth;
            stops.Add($"{hexes[i]} {start}px");
            stops.Add($"{hexes[i]} {end}px");
        }

        var primaryHex = hexes[0];
        var textCol2 = IsLight(primaryHex) ? "#111" : "#fff";
        return $"background:repeating-linear-gradient(90deg,{string.Join(",", stops)});color:{textCol2};text-shadow:0 1px 2px rgba(0,0,0,0.5)";
    }
}
