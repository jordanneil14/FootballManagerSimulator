@inject GameEngine Engine

@* Mentality and pressing for the user's club, or read-only for another club (the opposition on the
   match screen). Each option shows its advantage (+) and disadvantage (−). *@
@{
    var club = Club ?? Engine.MyClub;
    var instructions = club.Instructions ?? new TeamInstructionsModel();
    var locked = Disabled || ReadOnly;
}

<div class="panel" style="@(Disabled ? "opacity:.5;pointer-events:none" : ReadOnly ? "pointer-events:none" : "")">
    <h2>Team Instructions</h2>

    <div class="instr-group">
        <div class="instr-label">Mentality</div>
        <div class="seg">
            @foreach (var option in new[] { Mentality.Defensive, Mentality.Balanced, Mentality.Attacking })
            {
                <button class="seg-btn @(instructions.Mentality == option ? "active" : "")" disabled="@locked"
                        @onclick="() => SetMentality(option)">@option</button>
            }
        </div>
        @TradeOff(MentalityText(instructions.Mentality))
    </div>

    <div class="instr-group">
        <div class="instr-label">Pressing</div>
        <div class="seg">
            @foreach (var option in new[] { Pressing.Low, Pressing.Medium, Pressing.High })
            {
                <button class="seg-btn @(instructions.Pressing == option ? "active" : "")" disabled="@locked"
                        @onclick="() => SetPressing(option)">@option</button>
            }
        </div>
        @TradeOff(PressingText(instructions.Pressing))
    </div>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }

    // Shows another club's instructions (defaults to the user's club). Only the user's own can be changed.
    [Parameter] public ClubModel? Club { get; set; }

    // Shows the instructions at full strength but can't be changed: used for the opposition.
    [Parameter] public bool ReadOnly { get; set; }

    // Raised after a change, so the match screen can re-evaluate the rest of the match.
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool CanChange => !Disabled && !ReadOnly && (Club == null || Club.Id == Engine.MyClub.Id);

    private async Task SetMentality(Mentality mentality)
    {
        if (!CanChange || Engine.MyClub.Instructions?.Mentality == mentality) return;
        Engine.SetMentality(mentality);
        await OnChanged.InvokeAsync();
    }

    private async Task SetPressing(Pressing pressing)
    {
        if (!CanChange || Engine.MyClub.Instructions?.Pressing == pressing) return;
        Engine.SetPressing(pressing);
        await OnChanged.InvokeAsync();
    }

    private static (string? Plus, string? Minus) MentalityText(Mentality mentality) => mentality switch
    {
        Mentality.Defensive => ("Concede far fewer goals. More draws, so good for an underdog or for protecting a lead.",
                                "You score fewer too. A stronger side turns wins into draws."),
        Mentality.Attacking => ("More goals at both ends, so a stronger side's quality shows. Good for a favourite or for chasing a game.",
                                "Leaves you open. A weaker side usually loses more heavily."),
        _ => (null, null)
    };

    private static (string? Plus, string? Minus) PressingText(Pressing pressing) => pressing switch
    {
        Pressing.Low => ("Your players tire a little slower and pick up fewer bookings, and you're dangerous on the counter once a side that has been pressing starts to tire.",
                         "Gives the opponent the ball, so you create less."),
        Pressing.High => ("The strongest setting while your legs are fresh, and even better against a side that has tired itself out pressing.",
                          "More bookings and injuries, and your side tires once it has pressed for about 45 minutes. Low stamina makes the fade much worse."),
        _ => (null, null)
    };

    private static RenderFragment TradeOff((string? Plus, string? Minus) text) => __builder =>
    {
        if (text.Plus == null)
        {
            <div class="instr-note muted">Neutral: no advantage or disadvantage.</div>
            return;
        }
        <div class="instr-note plus">+ @text.Plus</div>
        <div class="instr-note minus">− @text.Minus</div>
    };
}
