@page "/fulltime"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Full Time</PageTitle>

@{
    var fixture = Engine.MyFixtureToday();
}

@if (fixture == null)
{
    <p class="muted">No match data.</p>
}
else
{
    var won = fixture.ClubWon?.Id == Engine.State.MyClubId;
    var draw = fixture.GoalsHome == fixture.GoalsAway;
    var myResult = draw ? "Draw" : won ? "Win" : "Loss";

    <div class="page-head">
        <div><h1>Full Time</h1><div class="subtitle">@Engine.State.DateFriendly</div></div>
        <div class="page-actions">
            <button class="btn btn-primary btn-lg" @onclick="Continue">Continue ⏩</button>
        </div>
    </div>

    <div class="scoreboard">
        <div class="teams">
            <div class="team-row">
                <span class="crest" style="@CrestStyle(fixture.HomeClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@fixture.HomeClub.Id">@fixture.HomeClub.Name</a>
                <div class="score">@fixture.GoalsHome</div>
            </div>
            <div class="team-row">
                <span class="crest" style="@CrestStyle(fixture.AwayClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@fixture.AwayClub.Id">@fixture.AwayClub.Name</a>
                <div class="score">@fixture.GoalsAway</div>
            </div>
        </div>
        <div class="minute">
            <span class="tag @(myResult == "Win" ? "green" : myResult == "Draw" ? "gold" : "red")">@myResult</span>
            · Full Time
        </div>
    </div>

    <div class="panel">
        <MatchLineups Fixture="fixture" ShowScorers="true" />
    </div>
}

@code {
    private void Continue()
    {
        Engine.CompleteRemainingFixtures();
        Nav.NavigateTo("/results");
    }

    private static readonly Dictionary<string, string> ColourMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Red"] = "#d32f2f", ["Blue"] = "#1565c0", ["White"] = "#e8e8e8", ["Black"] = "#1a1a1a",
        ["Yellow"] = "#f9a825", ["Green"] = "#2e7d32", ["Navy"] = "#1a237e", ["Sky Blue"] = "#4fc3f7",
        ["Light Blue"] = "#4fc3f7", ["Claret"] = "#7b1f3a", ["Maroon"] = "#7b1f3a", ["Amber"] = "#ff8f00",
        ["Gold"] = "#ffc107", ["Orange"] = "#e65100", ["Tangerine"] = "#ff6d00", ["Purple"] = "#7b1fa2",
    };

    private static string ToHex(string name) =>
        ColourMap.TryGetValue(name.Trim(), out var hex) ? hex : "#15c47e";

    private static bool IsLight(string hex)
    {
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
    }

    private static string CrestStyle(string colour)
    {
        if (string.IsNullOrWhiteSpace(colour)) return "";
        var parts = colour.Split('/');
        if (parts.Length == 1)
        {
            var hex = ToHex(parts[0]);
            var textCol = IsLight(hex) ? "#111" : "#fff";
            return $"background:{hex};color:{textCol}";
        }
        var hexes = parts.Select(p => ToHex(p)).ToArray();
        var stripeWidth = 6;
        var stops = new List<string>();
        for (var i = 0; i < hexes.Length; i++)
        {
            stops.Add($"{hexes[i]} {i * stripeWidth}px");
            stops.Add($"{hexes[i]} {(i + 1) * stripeWidth}px");
        }
        var textCol2 = IsLight(hexes[0]) ? "#111" : "#fff";
        return $"background:repeating-linear-gradient(90deg,{string.Join(",", stops)});color:{textCol2};text-shadow:0 1px 2px rgba(0,0,0,0.5)";
    }
}
