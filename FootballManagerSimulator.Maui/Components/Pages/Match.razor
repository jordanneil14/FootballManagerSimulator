@page "/match"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Match</PageTitle>

@{
    var fixture = Engine.MyFixtureToday();
}

@if (fixture == null)
{
    <p class="muted">No match in progress.</p>
}
else
{
    <div class="page-head">
        <div><h1>Live Match</h1><div class="subtitle">@Engine.State.DateFriendly</div></div>
        <div class="page-actions">
            <button class="btn btn-primary btn-lg" @onclick="Continue">Continue Match ⏩</button>
        </div>
    </div>

    <div class="scoreboard">
        <div class="teams">
            <div class="team-name">@fixture.HomeClub.Name</div>
            <div class="score">@fixture.GoalsHome&nbsp;-&nbsp;@fixture.GoalsAway</div>
            <div class="team-name">@fixture.AwayClub.Name</div>
        </div>
        <div class="minute">@MinuteCaption(fixture)</div>
    </div>

    <div class="panel">
        <MatchLineups Fixture="fixture" ShowScorers="true" />
    </div>
}

@code {
    private void Continue()
    {
        var concluded = Engine.ContinueMatch();
        if (concluded)
            Nav.NavigateTo("/fulltime");
    }

    private static string MinuteCaption(FixtureModel fixture) => fixture.Minute switch
    {
        <= 45 => "Half Time",
        <= 90 => "Full Time pending",
        <= 120 => "Extra Time",
        _ => "Penalties"
    };
}
