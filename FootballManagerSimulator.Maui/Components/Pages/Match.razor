@page "/match"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions
@implements IDisposable

<PageTitle>Match</PageTitle>

@if (_fixture == null)
{
    <p class="muted">No match in progress.</p>
}
else
{
    <div class="page-head">
        <div><h1>Live Match</h1>@if (_competition != null) {<div class="subtitle">@CompetitionHeading(_competition)</div>}</div>
        <div class="page-actions">
            @if (_phase == MatchPhase.HalfTime)
            {
                <button class="btn btn-primary btn-lg" @onclick="ContinueFromBreak">2nd Half ⏩</button>
            }
            else if (_phase == MatchPhase.FullTime || _phase == MatchPhase.Concluded)
            {
                <button class="btn btn-primary btn-lg" @onclick="GoToFullTime">Full Time ⏩</button>
            }
            else if (_phase == MatchPhase.ExtraTimeBreak)
            {
                <button class="btn btn-primary btn-lg" @onclick="ContinueFromBreak">Extra Time ⏩</button>
            }
            else if (_phase == MatchPhase.PenaltiesBreak)
            {
                <button class="btn btn-primary btn-lg" @onclick="StartPenalties">Penalties ⏩</button>
            }
            else
            {
                <button class="btn btn-primary btn-lg" @onclick="TogglePause">
                    @(_isPaused ? "Resume ▶" : "Pause ⏸")
                </button>
                <button class="btn btn-lg" @onclick="SkipToNextEvent" title="@SkipCaption()" aria-label="@SkipCaption()">⏭</button>
            }
        </div>
    </div>

    <div class="scoreboard">
        <div class="teams">
            <div class="team-row">
                <span class="crest" style="@CrestStyle(_fixture.HomeClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@_fixture.HomeClub.Id">@_fixture.HomeClub.Name</a>
                <div class="score">@_displayedHomeGoals</div>
            </div>
            <div class="team-row">
                <span class="crest" style="@CrestStyle(_fixture.AwayClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@_fixture.AwayClub.Id">@_fixture.AwayClub.Name</a>
                <div class="score">@_displayedAwayGoals</div>
            </div>
        </div>
        <div class="minute">@PhaseCaption()</div>
        @if (_eventFeed.Any())
        {
            var latest = _eventFeed[^1];
            <div class="event-row @latest.CssClass" style="font-size:.82rem;margin-top:.6rem;justify-content:center">
                <span class="event-icon">@latest.Icon</span>
                <span class="event-text">@latest.Description</span>
            </div>
        }
    </div>

    @if (_stoppageReason != null)
    {
        <div class="feedback"><div class="feedback-item warn">@_stoppageReason</div></div>
    }

    <ConfirmModal Visible="_confirmPlayOn"
                  Title="@($"Play on with {PlayersOnPitch} players?")"
                  Message="@PlayOnWarning()"
                  ConfirmText="Play On"
                  ConfirmClass="btn-danger"
                  OnConfirm="PlayOn"
                  OnCancel="() => _confirmPlayOn = false" />

    <div class="tab-bar">
        <button class="tab-btn @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Match Events</button>
        <button class="tab-btn @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Lineups</button>
        <button class="tab-btn @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">Tactics</button>
        <button class="tab-btn @(_tab == 4 ? "active" : "")" @onclick="() => _tab = 4">Opposition Tactics</button>
        <button class="tab-btn @(_tab == 3 ? "active" : "")" @onclick="() => _tab = 3">Live Scores</button>
        @if (LiveTableLeague != null)
        {
            <button class="tab-btn @(_tab == 5 ? "active" : "")" @onclick="() => _tab = 5">Live Table</button>
        }
    </div>

    @if (_tab == 0)
    {
        @if (_eventFeed.Any())
        {
            <div class="event-feed">
                @foreach (var evt in _eventFeed.AsEnumerable().Reverse())
                {
                    <div class="event-row @evt.CssClass">
                        <span class="event-minute">@evt.Minute'</span>
                        <span class="event-icon">@evt.Icon</span>
                        <span class="event-text">@evt.Description</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="muted">No events yet.</p>
        }
    }
    else if (_tab == 1)
    {
        <div class="panel">
            <h2>Lineups</h2>
            <MatchLineups Fixture="_fixture" ShowScorers="true" ShowMinutes="false" ShowTeamNames="false" LiveMinute="_currentMinute" />
        </div>
    }
    else if (_tab == 2)
    {
        @if (MatchFinished)
        {
            <div class="feedback"><div class="feedback-item warn">The match has finished</div></div>
        }
        else if (!_isPaused)
        {
            <div class="feedback"><div class="feedback-item warn">Pause the game to make changes</div></div>
        }
        else if (_swapError != null)
        {
            <div class="feedback"><div class="feedback-item warn">@_swapError</div></div>
        }

        <div class="panel" style="@(!CanEditTactics ? "opacity:.5;pointer-events:none" : "")">
            <h2>Formation</h2>
            <select class="input" value="@Engine.MyClub.Formation" disabled="@(!CanEditTactics)" @onchange="e => ChangeFormation(e.Value?.ToString() ?? Engine.MyClub.Formation)">
                @foreach (var f in FootballManagerSimulator.Maui.Helpers.TacticHelper.Formations)
                {
                    <option value="@f" selected="@(Engine.MyClub.Formation == f)">@f</option>
                }
            </select>
        </div>

        @* Unlimited changes; each one re-evaluates the rest of the match, just like a substitution. *@
        <TeamInstructionsPanel Disabled="@(!CanEditTactics)" OnChanged="OnInstructionsChanged" />

        @SquadPanel(Engine.MyClub, mine: true)
    }
    else if (_tab == 4 && OpponentClub is { } opponent)
    {
        @* The same as the Tactics tab, for the side we're playing, and never editable. *@
        <div class="panel">
            <h2>Formation</h2>
            <select class="input" disabled>
                <option selected>@opponent.Formation</option>
            </select>
        </div>

        <TeamInstructionsPanel Club="opponent" ReadOnly="true" />

        @SquadPanel(opponent, mine: false)
    }
    else if (_tab == 3)
    {
        var otherFixtures = Engine.TodaysFixtures()
            .Where(f => f != _fixture)
            .ToList();
        if (!otherFixtures.Any())
        {
            <p class="muted">No other matches in progress today.</p>
        }
        else
        {
            var settings = SettingsOptions.Value;
            var withCompetition = otherFixtures
                .Select(f => new { Fixture = f, Competition = Engine.GetCompetitionForFixture(f) })
                .Select(x => new { x.Fixture, x.Competition, Country = x.Competition == null ? SettingsModel.OtherCountry : settings.CountryName(x.Competition.Id) })
                .ToList();
            var countries = CountryTabs.Order(withCompetition.Select(x => x.Country));
            _liveScoresCountry = CountryTabs.Resolve(countries, _liveScoresCountry, _competition == null ? null : settings.CountryName(_competition.Id));
            var grouped = withCompetition
                .Where(x => x.Country == _liveScoresCountry)
                .GroupBy(x => x.Competition?.Id ?? 0)
                .OrderBy(g => g.Key);

            <CountryTabs Countries="countries" @bind-Selected="_liveScoresCountry" />

            @foreach (var group in grouped)
            {
                <div class="fixture-block">
                    <div class="fixture-block-head">@(group.First().Competition != null ? CompetitionHeading(group.First().Competition!) : "Other")</div>
                    @foreach (var item in group)
                    {
                        var f = item.Fixture;
                        var liveHome = f.HomeScorers.Count(g => g.Minute <= _currentMinute);
                        var liveAway = f.AwayScorers.Count(g => g.Minute <= _currentMinute);
                        <div class="fixture-row">
                            <div class="fixture-row-border"></div>
                            <div class="fixture-row-inner live">
                                <span class="fixture-team home">@f.HomeClub.Name</span>
                                <span class="fixture-score"><strong>@liveHome - @liveAway</strong></span>
                                <span class="fixture-team away">@f.AwayClub.Name</span>
                                <span class="live-minute">@LiveMinuteCaption(f)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
    else if (_tab == 5 && LiveTableLeague is { } liveLeague)
    {
        var table = LiveTable(liveLeague);
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th class="num">#</th><th>Club</th>
                        <th class="num">Pld</th><th class="num">Pts</th>
                        <th class="num">F</th><th class="num">A</th><th class="num">GD</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < table.Count; i++)
                    {
                        var row = table[i];
                        var position = i + 1;
                        var start = _liveTableStartPositions!.GetValueOrDefault(row.Club.Id, position);
                        <tr @key="row.Club.Id" class="@(row.Club.Id == Engine.State.MyClubId ? "highlight" : "") @LiveZoneClass(position, liveLeague)">
                            <td class="num">@position</td>
                            <td>
                                <strong>@row.Club.Name</strong>
                                @if (position != start)
                                {
                                    <span class="tag @(position < start ? "green" : "red")" style="margin-left:.4rem" title="@($"{FootballManagerSimulator.Maui.Helpers.NumberHelper.AddOrdinal(start)} at kick-off")">
                                        @FootballManagerSimulator.Maui.Helpers.NumberHelper.AddOrdinal(position) @(position < start ? "▲" : "▼")
                                    </span>
                                }
                            </td>
                            <td class="num">@row.Played</td>
                            <td class="num"><strong>@row.Points</strong></td>
                            <td class="num">@row.GoalsScored</td>
                            <td class="num">@row.GoalsConceded</td>
                            <td class="num">@row.GoalDifference</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private enum MatchPhase { FirstHalf, HalfTime, SecondHalf, FullTime, ExtraTime, ExtraTimeBreak, PenaltiesBreak, Concluded }

    private record MatchEvent(int Minute, string Icon, string Description, string CssClass);

    private int _tab;
    private string? _liveScoresCountry;
    private FixtureModel? _fixture;
    private ICompetition? _competition;

    private string CompetitionHeading(ICompetition competition)
    {
        var settings = SettingsOptions.Value;
        var config = settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }
    private Timer? _timer;
    private int _currentMinute;
    private int _displayedHomeGoals;
    private int _displayedAwayGoals;
    private bool _isPaused;
    private MatchPhase _phase = MatchPhase.FirstHalf;
    private readonly List<MatchEvent> _eventFeed = new();
    private int _revealedHomeGoals;
    private int _revealedAwayGoals;
    private int _revealedHomeCards;
    private int _revealedAwayCards;
    private int _revealedHomeInjuries;
    private int _revealedAwayInjuries;
    private int _revealedHomePenalties;
    private int _revealedAwayPenalties;
    private int? _selectedSlot;
    private string? _swapError;
    private string? _stoppageReason;
    private bool _confirmPlayOn;
    private Action? _afterPlayOn;
    private readonly HashSet<int> _playingOnInjured = [];

    private bool SubstitutionsLimited => _competition?.Type != CompetitionType.Friendly;

    // Only for a regular league match in my own league: cups, friendlies and play-offs don't move the table.
    private LeagueModel? LiveTableLeague =>
        _fixture?.FixtureType == FixtureType.Base && _competition is LeagueModel league && league.Id == Engine.CurrentClub?.LeagueId
            ? league
            : null;

    private List<LeaguePositionModel>? _liveTable;
    private Dictionary<int, int>? _liveTableStartPositions;
    private List<FixtureModel>? _liveTableFixtures;
    private int _liveTableGoals = -1;

    // The table as it stands. Goals so far only ever go up (a re-simulation only rewrites later minutes),
    // so the table is rebuilt only when today's goal count changes, not on every tick.
    private List<LeaguePositionModel> LiveTable(LeagueModel league)
    {
        var today = _fixture!.Date;
        _liveTableFixtures ??= league.Fixtures.Where(f => f.Date == today && f.FixtureType == FixtureType.Base).ToList();
        _liveTableStartPositions ??= league.GenerateLiveLeagueTable(today, null)
            .Select((row, i) => (row.Club.Id, Position: i + 1))
            .ToDictionary(p => p.Id, p => p.Position);

        var goals = _liveTableFixtures.Sum(f => { var s = LiveScore(f); return s.Home + s.Away; });
        if (_liveTable == null || goals != _liveTableGoals)
        {
            _liveTable = league.GenerateLiveLeagueTable(today, LiveScore);
            _liveTableGoals = goals;
        }
        return _liveTable;
    }

    private (int Home, int Away) LiveScore(FixtureModel fixture) => fixture == _fixture
        ? (_displayedHomeGoals, _displayedAwayGoals)
        : (fixture.HomeScorers.Count(g => g.Minute <= _currentMinute), fixture.AwayScorers.Count(g => g.Minute <= _currentMinute));

    private static string LiveZoneClass(int position, LeagueModel league)
    {
        var places = league.Clubs.Count;
        if (position <= league.AutomaticPromotionPlaces) return "zone-promo";
        if (position <= league.AutomaticPromotionPlaces + league.PlayoffPlaces) return "zone-playoff";
        if (position > places - league.RelegationPlaces) return "zone-releg";
        if (position > places - league.RelegationPlaces - league.RelegationPlayoffPlaces) return "zone-playoff";
        return "";
    }

    protected override void OnInitialized()
    {
        _fixture = Engine.MyFixtureToday();
        if (_fixture == null) return;

        _competition = Engine.GetCompetitionForFixture(_fixture);

        var resumeMinute = _fixture.Minute;
        if (resumeMinute > 0)
        {
            _currentMinute = resumeMinute;
            _displayedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
            _displayedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
            _revealedHomeGoals = _displayedHomeGoals;
            _revealedAwayGoals = _displayedAwayGoals;
            _revealedHomeCards = _fixture.HomeCards.Count(c => c.Minute <= _currentMinute);
            _revealedAwayCards = _fixture.AwayCards.Count(c => c.Minute <= _currentMinute);
            _revealedHomeInjuries = _fixture.HomeInjuries.Count(i => i.Minute <= _currentMinute);
            _revealedAwayInjuries = _fixture.AwayInjuries.Count(i => i.Minute <= _currentMinute);
            _revealedHomePenalties = _fixture.HomePenalties.Count(p => p.Minute <= _currentMinute);
            _revealedAwayPenalties = _fixture.AwayPenalties.Count(p => p.Minute <= _currentMinute);

            _eventFeed.Add(new MatchEvent(0, "🟢", "Kick Off!", ""));
            RebuildEventFeed();

            if (_fixture.Concluded)
            {
                _phase = MatchPhase.Concluded;
                _isPaused = true;
            }
            else if (_currentMinute >= 120)
            {
                _phase = MatchPhase.Concluded;
                _isPaused = true;
            }
            else if (_currentMinute >= 90)
            {
                _phase = MatchPhase.ExtraTime;
                _isPaused = true;
            }
            else if (_currentMinute >= 45)
            {
                _phase = MatchPhase.SecondHalf;
                _isPaused = true;
            }
            else
            {
                _phase = MatchPhase.FirstHalf;
                _isPaused = true;
            }
        }
        else
        {
            _currentMinute = 0;
            _displayedHomeGoals = 0;
            _displayedAwayGoals = 0;
            _phase = MatchPhase.FirstHalf;
            _eventFeed.Add(new MatchEvent(0, "🟢", "Kick Off!", ""));
        }

        var speed = Engine.State.MatchSpeedMs;
        _timer = new Timer(OnTick, null, speed, speed);
    }

    private void RebuildEventFeed()
    {
        if (_fixture == null) return;

        var events = new List<(int Minute, MatchEvent Event)>();

        // Penalties go in before goals so that, after the stable sort, an award comes before the goal it led to.
        foreach (var p in _fixture.HomePenalties.Where(p => p.Minute <= _currentMinute))
            events.AddRange(PenaltyEvents(p, _fixture.HomeClub, _fixture.AwayClub).Select(e => (e.Minute, e)));
        foreach (var p in _fixture.AwayPenalties.Where(p => p.Minute <= _currentMinute))
            events.AddRange(PenaltyEvents(p, _fixture.AwayClub, _fixture.HomeClub).Select(e => (e.Minute, e)));

        foreach (var g in _fixture.HomeScorers.Where(g => g.Minute <= _currentMinute))
            events.Add((g.Minute, new MatchEvent(g.Minute, "⚽", GoalText(g, _fixture.HomeClub), "event-goal")));
        foreach (var g in _fixture.AwayScorers.Where(g => g.Minute <= _currentMinute))
            events.Add((g.Minute, new MatchEvent(g.Minute, "⚽", GoalText(g, _fixture.AwayClub), "event-goal")));
        foreach (var c in _fixture.HomeCards.Where(c => c.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(c.PlayerId);
            var icon = c.IsRed ? "🟥" : "🟨";
            var type = c.IsRed ? "Red card" : "Yellow card";
            events.Add((c.Minute, new MatchEvent(c.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", c.IsRed ? "event-red" : "event-yellow")));
        }
        foreach (var c in _fixture.AwayCards.Where(c => c.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(c.PlayerId);
            var icon = c.IsRed ? "🟥" : "🟨";
            var type = c.IsRed ? "Red card" : "Yellow card";
            events.Add((c.Minute, new MatchEvent(c.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", c.IsRed ? "event-red" : "event-yellow")));
        }
        foreach (var i in _fixture.HomeInjuries.Where(i => i.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(i.PlayerId);
            events.Add((i.Minute, new MatchEvent(i.Minute, "", $"Injury - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name}) - {i.Description}", "event-injury")));
        }
        foreach (var i in _fixture.AwayInjuries.Where(i => i.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(i.PlayerId);
            events.Add((i.Minute, new MatchEvent(i.Minute, "", $"Injury - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name}) - {i.Description}", "event-injury")));
        }

        foreach (var e in events.OrderBy(e => e.Minute))
            _eventFeed.Add(e.Event);
    }

    private string GoalText(GoalModel goal, ClubModel club) =>
        $"GOAL! {Engine.GetPlayer(goal.PlayerId)?.Name ?? "Unknown"} ({club.Name}){(goal.IsPenalty ? " - penalty" : "")}";

    // The award, then how it was missed; a scored penalty's second line is its goal.
    private IEnumerable<MatchEvent> PenaltyEvents(PenaltyModel penalty, ClubModel side, ClubModel defending)
    {
        yield return new MatchEvent(penalty.Minute, "🎯", $"Penalty - {side.Name}", "event-penalty");

        var taker = Engine.GetPlayer(penalty.TakerId)?.Name ?? "Unknown";
        if (penalty.Outcome == PenaltyOutcome.Saved)
        {
            var keeper = penalty.KeeperId is { } keeperId ? Engine.GetPlayer(keeperId)?.Name : null;
            yield return new MatchEvent(penalty.Minute, "🧤", $"Penalty saved - {keeper ?? "Unknown"} ({defending.Name}) saves from {taker} ({side.Name})", "event-penalty-miss");
        }
        else if (penalty.Outcome == PenaltyOutcome.Missed)
        {
            yield return new MatchEvent(penalty.Minute, "❌", $"Penalty missed - {taker} ({side.Name})", "event-penalty-miss");
        }
    }

    // The timer ticks on a background thread, so a tick and a skip must not run at once.
    private readonly object _clockLock = new();

    private int StoppageMinute => _phase switch
    {
        MatchPhase.FirstHalf => 45,
        MatchPhase.SecondHalf => 90,
        MatchPhase.ExtraTime => 120,
        _ => 90
    };

    private async void OnTick(object? state)
    {
        lock (_clockLock)
        {
            if (_isPaused) return;

            _currentMinute++;
            RevealEvents();

            if (_currentMinute >= StoppageMinute)
            {
                _currentMinute = StoppageMinute;
                _isPaused = true;
                TransitionPhase();
            }

            SyncFixtureClock();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void SkipToNextEvent()
    {
        if (WarnBeforePlayingOn(SkipToNextEvent)) return;
        _stoppageReason = null;

        lock (_clockLock)
        {
            if (_phase is not (MatchPhase.FirstHalf or MatchPhase.SecondHalf or MatchPhase.ExtraTime))
                return;

            var stoppage = StoppageMinute;
            var myInjuries = _fixture!.HomeClub.Id == Engine.State.MyClubId
                ? _fixture.HomeInjuries : _fixture.AwayClub.Id == Engine.State.MyClubId
                ? _fixture.AwayInjuries : Enumerable.Empty<InjuryModel>();
            var nextMajor = _fixture.HomeScorers.Select(g => g.Minute)
                .Concat(_fixture.AwayScorers.Select(g => g.Minute))
                .Concat(_fixture.HomeCards.Where(c => c.IsRed).Select(c => c.Minute))
                .Concat(_fixture.AwayCards.Where(c => c.IsRed).Select(c => c.Minute))
                .Concat(myInjuries.Select(i => i.Minute))
                .Concat(_fixture.HomePenalties.Concat(_fixture.AwayPenalties).Select(p => p.Minute))
                .Where(m => m > _currentMinute && m <= stoppage)
                .Order()
                .FirstOrDefault();

            _selectedSlot = null;
            _currentMinute = nextMajor > 0 ? nextMajor : stoppage;
            RevealEvents();

            if (_currentMinute >= stoppage)
            {
                _currentMinute = stoppage;
                _isPaused = true;
                TransitionPhase();
            }

            SyncFixtureClock();
        }
    }

    private void SyncFixtureClock()
    {
        _fixture!.Minute = _currentMinute;
        _fixture.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;
    }

    private string SkipCaption() => "Skip to Next Event";

    private void RevealEvents()
    {
        if (_fixture == null) return;

        // Before the goals, so a penalty's award line comes before the goal it led to.
        foreach (var penalty in _fixture.HomePenalties.Where(p => p.Minute <= _currentMinute).OrderBy(p => p.Minute).Skip(_revealedHomePenalties).ToList())
        {
            _eventFeed.AddRange(PenaltyEvents(penalty, _fixture.HomeClub, _fixture.AwayClub));
            _revealedHomePenalties++;
        }

        foreach (var penalty in _fixture.AwayPenalties.Where(p => p.Minute <= _currentMinute).OrderBy(p => p.Minute).Skip(_revealedAwayPenalties).ToList())
        {
            _eventFeed.AddRange(PenaltyEvents(penalty, _fixture.AwayClub, _fixture.HomeClub));
            _revealedAwayPenalties++;
        }

        var homeGoalsToReveal = _fixture.HomeScorers
            .Where(g => g.Minute <= _currentMinute)
            .OrderBy(g => g.Minute)
            .Skip(_revealedHomeGoals)
            .ToList();

        foreach (var goal in homeGoalsToReveal)
        {
            _eventFeed.Add(new MatchEvent(goal.Minute, "⚽", GoalText(goal, _fixture.HomeClub), "event-goal"));
            _revealedHomeGoals++;
        }

        var awayGoalsToReveal = _fixture.AwayScorers
            .Where(g => g.Minute <= _currentMinute)
            .OrderBy(g => g.Minute)
            .Skip(_revealedAwayGoals)
            .ToList();

        foreach (var goal in awayGoalsToReveal)
        {
            _eventFeed.Add(new MatchEvent(goal.Minute, "⚽", GoalText(goal, _fixture.AwayClub), "event-goal"));
            _revealedAwayGoals++;
        }

        var homeCardsToReveal = _fixture.HomeCards
            .Where(c => c.Minute <= _currentMinute)
            .OrderBy(c => c.Minute)
            .Skip(_revealedHomeCards)
            .ToList();

        foreach (var card in homeCardsToReveal)
        {
            var player = Engine.GetPlayer(card.PlayerId);
            var icon = card.IsRed ? "🟥" : "🟨";
            var type = card.IsRed ? "Red card" : "Yellow card";
            _eventFeed.Add(new MatchEvent(card.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", card.IsRed ? "event-red" : "event-yellow"));
            _revealedHomeCards++;
            if (card.IsRed && IsMyClub(_fixture.HomeClub)) StopForSendingOff(player);
        }

        var awayCardsToReveal = _fixture.AwayCards
            .Where(c => c.Minute <= _currentMinute)
            .OrderBy(c => c.Minute)
            .Skip(_revealedAwayCards)
            .ToList();

        foreach (var card in awayCardsToReveal)
        {
            var player = Engine.GetPlayer(card.PlayerId);
            var icon = card.IsRed ? "🟥" : "🟨";
            var type = card.IsRed ? "Red card" : "Yellow card";
            _eventFeed.Add(new MatchEvent(card.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", card.IsRed ? "event-red" : "event-yellow"));
            _revealedAwayCards++;
            if (card.IsRed && IsMyClub(_fixture.AwayClub)) StopForSendingOff(player);
        }

        var homeInjuriesToReveal = _fixture.HomeInjuries
            .Where(i => i.Minute <= _currentMinute)
            .OrderBy(i => i.Minute)
            .Skip(_revealedHomeInjuries)
            .ToList();

        foreach (var injury in homeInjuriesToReveal)
        {
            var player = Engine.GetPlayer(injury.PlayerId);
            _eventFeed.Add(new MatchEvent(injury.Minute, "", $"Injury - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name}) - {injury.Description}", "event-injury"));
            _revealedHomeInjuries++;
            if (IsMyClub(_fixture.HomeClub)) StopForInjury(player, injury);
        }

        var awayInjuriesToReveal = _fixture.AwayInjuries
            .Where(i => i.Minute <= _currentMinute)
            .OrderBy(i => i.Minute)
            .Skip(_revealedAwayInjuries)
            .ToList();

        foreach (var injury in awayInjuriesToReveal)
        {
            var player = Engine.GetPlayer(injury.PlayerId);
            _eventFeed.Add(new MatchEvent(injury.Minute, "", $"Injury - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name}) - {injury.Description}", "event-injury"));
            _revealedAwayInjuries++;
            if (IsMyClub(_fixture.AwayClub)) StopForInjury(player, injury);
        }

        // A skip reveals several minutes at once, added above one event type at a time, so put the
        // feed back in minute order (a stable sort keeps same-minute events as they were).
        var ordered = _eventFeed.OrderBy(e => e.Minute).ToList();
        _eventFeed.Clear();
        _eventFeed.AddRange(ordered);

        _displayedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
        _displayedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
    }

    private void TransitionPhase()
    {
        _phase = _phase switch
        {
            MatchPhase.FirstHalf => MatchPhase.HalfTime,
            MatchPhase.SecondHalf => CheckFullTime(),
            MatchPhase.ExtraTime => CheckExtraTimeEnd(),
            _ => _phase
        };

        if (_phase == MatchPhase.FullTime || _phase == MatchPhase.Concluded)
            ConcludeMatch();
    }

    private MatchPhase CheckFullTime()
    {
        if (_competition?.Type.IsKnockout() == true && _displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture!);
            return MatchPhase.ExtraTimeBreak;
        }

        if (_fixture?.FixtureType == FixtureType.PlayoffSecondLeg && _competition != null)
        {
            Engine.MatchSimulator.PopulateFirstLegScores(_fixture, _competition);
            var homeAgg = _displayedHomeGoals + (_fixture.FirstLegGoalsAway ?? 0);
            var awayAgg = _displayedAwayGoals + (_fixture.FirstLegGoalsHome ?? 0);
            var higherPlacedClubGoesThrough = (_competition as LeagueModel)?.LevelTieGoesToHigherPlacedClub(_fixture) == true;
            if (homeAgg == awayAgg && !higherPlacedClubGoesThrough)
            {
                Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture);
                return MatchPhase.ExtraTimeBreak;
            }
        }

        if ((_fixture?.FixtureType == FixtureType.PlayoffFinal ||
             (_competition is LeagueModel league && league.IsOneOffPlayoffMatch(_fixture!)))
            && _displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture!);
            return MatchPhase.ExtraTimeBreak;
        }

        return MatchPhase.FullTime;
    }

    private MatchPhase CheckExtraTimeEnd()
    {
        if (_fixture?.FixtureType == FixtureType.PlayoffSecondLeg)
        {
            var homeAgg = _displayedHomeGoals + (_fixture.FirstLegGoalsAway ?? 0);
            var awayAgg = _displayedAwayGoals + (_fixture.FirstLegGoalsHome ?? 0);
            if (homeAgg == awayAgg)
            {
                Engine.MatchSimulator.GeneratePenaltyEvents(_fixture);
                return MatchPhase.PenaltiesBreak;
            }
            return MatchPhase.FullTime;
        }

        if (_displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GeneratePenaltyEvents(_fixture!);
            return MatchPhase.PenaltiesBreak;
        }
        return MatchPhase.FullTime;
    }

    private void ConcludeMatch()
    {
        if (_fixture == null) return;
        _fixture.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;
        Engine.FinalisePlayerMatch(_fixture);
    }

    private void ContinueFromBreak()
    {
        if (!WarnBeforePlayingOn(Restart)) Restart();
    }

    // Asks before play continues while an injured player the user hasn't agreed to play on with is
    // still in the XI. Returns true if it asked, in which case `then` runs once they confirm.
    private bool WarnBeforePlayingOn(Action then)
    {
        if (InjuredOnPitch().All(p => _playingOnInjured.Contains(p.Id))) return false;
        _afterPlayOn = then;
        _confirmPlayOn = true;
        return true;
    }

    // Restarts play from a pause or a break.
    private void Restart()
    {
        _phase = _phase switch
        {
            MatchPhase.HalfTime => MatchPhase.SecondHalf,
            MatchPhase.ExtraTimeBreak => MatchPhase.ExtraTime,
            _ => _phase
        };
        _isPaused = false;
        _selectedSlot = null;
        _stoppageReason = null;
    }

    private bool IsMyClub(ClubModel club) => club.Id == Engine.State.MyClubId;

    // A red card or injury for the user's side stops the clock so they can react before play goes on.
    private void StopForSendingOff(PlayerModel? player)
    {
        _isPaused = true;
        _stoppageReason = $"🟥 {player?.Name ?? "A player"} has been sent off. Reorganise from the Tactics tab, then resume.";
    }

    private void StopForInjury(PlayerModel? player, InjuryModel injury)
    {
        _isPaused = true;
        _stoppageReason = $"🤕 {player?.Name ?? "A player"} is injured ({injury.Description.ToLower()}). Substitute him from the Tactics tab, then resume.";
    }

    // The user's injured players still in the starting XI, who leave the side a player short.
    private List<PlayerModel> InjuredOnPitch()
    {
        if (_fixture == null) return [];
        var injuries = IsMyClub(_fixture.HomeClub) ? _fixture.HomeInjuries
            : IsMyClub(_fixture.AwayClub) ? _fixture.AwayInjuries : [];
        var sentOff = MySentOffIds();
        var starters = Engine.MyClub.TacticSlots
            .Where(s => s.TacticSlotType is not (TacticSlotType.SUB or TacticSlotType.RES))
            .Select(s => s.PlayerId)
            .ToHashSet();
        return injuries
            .Where(i => i.Minute <= _currentMinute && starters.Contains(i.PlayerId) && !sentOff.Contains(i.PlayerId))
            .Select(i => Engine.GetPlayer(i.PlayerId))
            .OfType<PlayerModel>()
            .ToList();
    }

    private HashSet<int> MySentOffIds()
    {
        if (_fixture == null) return [];
        var cards = IsMyClub(_fixture.HomeClub) ? _fixture.HomeCards
            : IsMyClub(_fixture.AwayClub) ? _fixture.AwayCards : [];
        return cards.Where(c => c.IsRed && c.Minute <= _currentMinute).Select(c => c.PlayerId).ToHashSet();
    }

    private int PlayersOnPitch => 11 - MySentOffIds().Count - InjuredOnPitch().Count;

    private string PlayOnWarning()
    {
        var injured = InjuredOnPitch();
        var names = string.Join(" and ", injured.Select(p => p.Name));
        var verb = injured.Count == 1 ? "is" : "are";
        return $"{names} {verb} injured and can't carry on. If you play on without a substitution, " +
               $"you'll be playing with {PlayersOnPitch} players until you make one.";
    }

    private void PlayOn()
    {
        _confirmPlayOn = false;
        _playingOnInjured.UnionWith(InjuredOnPitch().Select(p => p.Id));
        var then = _afterPlayOn;
        _afterPlayOn = null;
        then?.Invoke();
    }

    private void StartPenalties()
    {
        _currentMinute = 121;
        RevealEvents();
        _fixture!.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;
        _phase = MatchPhase.Concluded;
        ConcludeMatch();
        StateHasChanged();
    }

    private void GoToFullTime()
    {
        Nav.NavigateTo("/fulltime");
    }

    private void TogglePause()
    {
        if (!_isPaused) { _isPaused = true; return; }
        if (!WarnBeforePlayingOn(Restart)) Restart();
    }

    // Green in-arrow for a player brought on, red out-arrow for one taken off, with the minute.
    private RenderFragment SubArrows(PlayerModel? player) => __builder =>
    {
        if (player == null || _fixture == null) return;
        foreach (var minute in Engine.SubbedOnMinutes(_fixture, player.Id))
        {
            <span class="sub-arrow sub-in" title="Substituted on">▲ @(minute)'</span>
        }
        foreach (var minute in Engine.SubbedOffMinutes(_fixture, player.Id))
        {
            <span class="sub-arrow sub-out" title="Substituted off">▼ @(minute)'</span>
        }
    };

    private ClubModel? OpponentClub => _fixture == null ? null
        : Engine.GetClub(IsMyClub(_fixture.HomeClub) ? _fixture.AwayClub.Id : _fixture.HomeClub.Id);

    private bool IsHomeSide(ClubModel club) => club.Id == _fixture!.HomeClub.Id;

    private HashSet<int> SentOffIds(ClubModel club) =>
        (IsHomeSide(club) ? _fixture!.HomeCards : _fixture!.AwayCards)
            .Where(c => c.IsRed && c.Minute <= _currentMinute).Select(c => c.PlayerId).ToHashSet();

    private HashSet<int> InjuredIds(ClubModel club) =>
        (IsHomeSide(club) ? _fixture!.HomeInjuries : _fixture!.AwayInjuries)
            .Where(i => i.Minute <= _currentMinute).Select(i => i.PlayerId).ToHashSet();

    // The starters and bench with live fitness. Only the user's own side can be tapped to swap;
    // the opposition's is shown the same way but can't be changed.
    private RenderFragment SquadPanel(ClubModel club, bool mine) => __builder =>
    {
        var canEdit = mine && CanEditTactics;
        var starters = club.TacticSlots.Where(s => s.TacticSlotType != TacticSlotType.SUB && s.TacticSlotType != TacticSlotType.RES).ToList();
        var subs = club.TacticSlots.Where(s => s.TacticSlotType == TacticSlotType.SUB).ToList();
        var injuredIds = mine ? InjuredOnPitch().Select(p => p.Id).ToHashSet() : InjuredIds(club);
        var sentOffIds = SentOffIds(club);

        <div class="panel" style="@(mine && !CanEditTactics ? "opacity:.5;pointer-events:none" : !mine ? "pointer-events:none" : "")">
            <h2>Squad @(canEdit ? "(tap to swap)" : "")</h2>
            <div class="table-wrap"><table class="data squad-table">
                <tbody>
                    @for (var i = 0; i < starters.Count; i++)
                    {
                        var idx = club.TacticSlots.IndexOf(starters[i]);
                        var slot = starters[i];
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        var sentOff = player != null && sentOffIds.Contains(player.Id);
                        var injured = player != null && !sentOff && injuredIds.Contains(player.Id);
                        <tr class="@(canEdit ? "clickable" : "") @(mine && _selectedSlot == idx ? "highlight" : "") @(sentOff || injured ? "row-injured" : "")"
                            @onclick="() => { if (mine) OnSlotClick(idx); }">
                            <td class="sq-slot"><span class="pos-chip @Ui.PositionCssClass(slot.TacticSlotType.ToString())">@slot.TacticSlotType</span></td>
                            <td class="squad-name" title="@player?.Name">@(player != null ? Surname(player.Name) : "— empty —")@if (mine) { @SubArrows(player) }@if (sentOff) { <span> 🟥</span> } else if (injured) { <span> 🤕</span> }</td>
                            <td class="num sq-pos @Ui.FamiliarityCssClass(player, slot.TacticSlotType)" title="@Ui.FamiliarityTitle(player, slot.TacticSlotType)">@(player?.PreferredPosition ?? "")</td>
                            <td class="num sq-rating" title="@Ui.FamiliarityTitle(player, slot.TacticSlotType)"><EffectiveRating Player="player" Slot="slot.TacticSlotType" /></td>
                            <td class="num sq-fit">@if (player != null) { <FitnessBar Value="LiveFitness(player)" Compact="true" /> }</td>
                        </tr>
                    }
                </tbody>
            </table></div>

            <h3 style="margin-top:1rem">
                Substitutions
                @if (mine && SubstitutionsLimited)
                {
                    <span class="muted" style="font-weight:normal">(@Engine.SubstitutionsMade(_fixture!) / @GameEngine.MaxSubstitutions used)</span>
                }
            </h3>
            <div class="table-wrap"><table class="data squad-table">
                <tbody>
                    @for (var i = 0; i < subs.Count; i++)
                    {
                        var idx = club.TacticSlots.IndexOf(subs[i]);
                        var slot = subs[i];
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        var posLabel = player?.Position ?? "SUB";
                        <tr class="@(canEdit ? "clickable" : "") @(mine && _selectedSlot == idx ? "highlight" : "")"
                            @onclick="() => { if (mine) OnSlotClick(idx); }">
                            <td class="sq-slot"><span class="pos-chip @Ui.PositionCssClass(posLabel)">@posLabel</span></td>
                            <td class="squad-name" title="@player?.Name">@(player != null ? Surname(player.Name) : "— empty —")@if (mine) { @SubArrows(player) }</td>
                            <td class="num sq-rating">@(player?.Rating.ToString() ?? "")</td>
                            <td class="num sq-fit">@if (player != null) { <FitnessBar Value="LiveFitness(player)" Compact="true" /> }</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </div>
    };

    private bool MatchFinished => _phase is MatchPhase.FullTime or MatchPhase.Concluded;

    // Tactics can only change while the match is paused, and not once it's over.
    private bool CanEditTactics => _isPaused && !MatchFinished;

    private void OnSlotClick(int index)
    {
        if (!CanEditTactics) return;
        if (_selectedSlot == null) { _selectedSlot = index; _swapError = null; return; }
        if (_selectedSlot == index) { _selectedSlot = null; return; }
        _swapError = Engine.MatchSwap(_fixture!, _competition, _selectedSlot.Value, index, _currentMinute);
        _selectedSlot = null;
        if (_swapError == null)
            OnLineupChanged();
    }

    private void ChangeFormation(string formation)
    {
        if (!CanEditTactics || formation == Engine.MyClub.Formation) return;
        Engine.ChangeFormation(formation);
        OnLineupChanged();
    }

    // A player's fitness at the current minute of this match (it drops while he's on the pitch).
    private double LiveFitness(PlayerModel player) =>
        _fixture == null ? player.Fitness : Engine.MatchSimulator.FitnessAt(_fixture, player.Id, _currentMinute);

    private void OnInstructionsChanged()
    {
        if (!CanEditTactics) return;
        OnLineupChanged();
    }

    private void OnLineupChanged()
    {
        if (_fixture == null) return;
        Engine.MatchSimulator.ReGenerateFromMinute(_fixture, _currentMinute);

        _revealedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
        _revealedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
        _revealedHomeCards = _fixture.HomeCards.Count(c => c.Minute <= _currentMinute);
        _revealedAwayCards = _fixture.AwayCards.Count(c => c.Minute <= _currentMinute);
        _revealedHomePenalties = _fixture.HomePenalties.Count(p => p.Minute <= _currentMinute);
        _revealedAwayPenalties = _fixture.AwayPenalties.Count(p => p.Minute <= _currentMinute);

        _eventFeed.RemoveAll(e => e.Minute > _currentMinute);
    }

    private string PhaseCaption() => _phase switch
    {
        MatchPhase.FirstHalf => $"{_currentMinute}'",
        MatchPhase.HalfTime => "Half Time",
        MatchPhase.SecondHalf => $"{_currentMinute}'",
        MatchPhase.FullTime => "Full Time",
        MatchPhase.ExtraTime => $"{_currentMinute}' (ET)",
        MatchPhase.ExtraTimeBreak => "Extra Time",
        MatchPhase.PenaltiesBreak => "Penalties",
        MatchPhase.Concluded => "Full Time",
        _ => ""
    };

    // The other games kick off with ours and run on the same clock. They are played out in full at
    // kick-off, so a game's Minute is where it ends: 90, or 120 if it went to extra time.
    private string LiveMinuteCaption(FixtureModel fixture) => _phase switch
    {
        MatchPhase.HalfTime => "HT",
        _ when fixture.Concluded && _currentMinute >= fixture.Minute => "FT",
        _ => $"{_currentMinute}'"
    };

    private static string Surname(string name)
    {
        var parts = name.Split(' ');
        return parts.Length > 1 ? parts[^1] : name;
    }

    private static readonly Dictionary<string, string> ColourMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Red"] = "#d32f2f", ["Blue"] = "#1565c0", ["White"] = "#e8e8e8", ["Black"] = "#1a1a1a",
        ["Yellow"] = "#f9a825", ["Green"] = "#2e7d32", ["Navy"] = "#1a237e", ["Sky Blue"] = "#4fc3f7",
        ["Light Blue"] = "#4fc3f7", ["Claret"] = "#7b1f3a", ["Maroon"] = "#7b1f3a", ["Amber"] = "#ff8f00",
        ["Gold"] = "#ffc107", ["Orange"] = "#e65100", ["Tangerine"] = "#ff6d00", ["Purple"] = "#7b1fa2",
    };

    private static string ToHex(string name) =>
        ColourMap.TryGetValue(name.Trim(), out var hex) ? hex : "#15c47e";

    private static bool IsLight(string hex)
    {
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
    }

    private static string CrestStyle(string colour)
    {
        if (string.IsNullOrWhiteSpace(colour)) return "";
        var parts = colour.Split('/');
        if (parts.Length == 1)
        {
            var hex = ToHex(parts[0]);
            var textCol = IsLight(hex) ? "#111" : "#fff";
            return $"background:{hex};color:{textCol}";
        }
        var hexes = parts.Select(p => ToHex(p)).ToArray();
        var stripeWidth = 6;
        var stops = new List<string>();
        for (var i = 0; i < hexes.Length; i++)
        {
            stops.Add($"{hexes[i]} {i * stripeWidth}px");
            stops.Add($"{hexes[i]} {(i + 1) * stripeWidth}px");
        }
        var textCol2 = IsLight(hexes[0]) ? "#111" : "#fff";
        return $"background:repeating-linear-gradient(90deg,{string.Join(",", stops)});color:{textCol2};text-shadow:0 1px 2px rgba(0,0,0,0.5)";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
