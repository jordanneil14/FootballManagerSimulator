@page "/match"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions
@implements IDisposable

<PageTitle>Match</PageTitle>

@if (_fixture == null)
{
    <p class="muted">No match in progress.</p>
}
else
{
    <div class="page-head">
        <div><h1>Live Match</h1><div class="subtitle">@(_competition != null ? CompetitionHeading(_competition) : Engine.State.DateFriendly)</div></div>
        <div class="page-actions">
            @if (_phase == MatchPhase.HalfTime)
            {
                <button class="btn btn-primary btn-lg" @onclick="ContinueFromBreak">2nd Half ⏩</button>
            }
            else if (_phase == MatchPhase.FullTime || _phase == MatchPhase.Concluded)
            {
                <button class="btn btn-primary btn-lg" @onclick="GoToFullTime">Full Time ⏩</button>
            }
            else if (_phase == MatchPhase.ExtraTimeBreak)
            {
                <button class="btn btn-primary btn-lg" @onclick="ContinueFromBreak">Extra Time ⏩</button>
            }
            else if (_phase == MatchPhase.PenaltiesBreak)
            {
                <button class="btn btn-primary btn-lg" @onclick="StartPenalties">Penalties ⏩</button>
            }
            else
            {
                <button class="btn btn-primary btn-lg" @onclick="TogglePause">
                    @(_isPaused ? "Resume ▶" : "Pause ⏸")
                </button>
            }
        </div>
    </div>

    <div class="scoreboard">
        <div class="teams">
            <div class="team-row">
                <span class="crest" style="@CrestStyle(_fixture.HomeClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@_fixture.HomeClub.Id">@_fixture.HomeClub.Name</a>
                <div class="score">@_displayedHomeGoals</div>
            </div>
            <div class="team-row">
                <span class="crest" style="@CrestStyle(_fixture.AwayClub.Colour)">🛡️</span>
                <a class="team-name" style="flex:1" href="/club/@_fixture.AwayClub.Id">@_fixture.AwayClub.Name</a>
                <div class="score">@_displayedAwayGoals</div>
            </div>
        </div>
        <div class="minute">@PhaseCaption()</div>
        @if (_eventFeed.Any())
        {
            var latest = _eventFeed[^1];
            <div class="event-row @latest.CssClass" style="font-size:.82rem;margin-top:.6rem;justify-content:center">
                <span class="event-icon">@latest.Icon</span>
                <span class="event-text">@latest.Description</span>
            </div>
        }
    </div>

    <div class="tab-bar">
        <button class="tab-btn @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Match Events</button>
        <button class="tab-btn @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Lineups</button>
        <button class="tab-btn @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">Tactics</button>
        <button class="tab-btn @(_tab == 3 ? "active" : "")" @onclick="() => _tab = 3">Live Scores</button>
        <button class="tab-btn @(_tab == 4 ? "active" : "")" @onclick="() => _tab = 4">Formations</button>
    </div>

    @if (_tab == 0)
    {
        @if (_eventFeed.Any())
        {
            <div class="event-feed">
                @foreach (var evt in _eventFeed.AsEnumerable().Reverse())
                {
                    <div class="event-row @evt.CssClass">
                        <span class="event-minute">@evt.Minute'</span>
                        <span class="event-icon">@evt.Icon</span>
                        <span class="event-text">@evt.Description</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="muted">No events yet.</p>
        }
    }
    else if (_tab == 1)
    {
        <div class="panel">
            <h2>Lineups</h2>
            <MatchLineups Fixture="_fixture" ShowScorers="true" ShowMinutes="false" ShowTeamNames="false" LiveMinute="_currentMinute" />
        </div>
    }
    else if (_tab == 2)
    {
        @if (!_isPaused)
        {
            <div class="feedback"><div class="feedback-item warn">Pause the game to make changes</div></div>
        }

        <div class="panel" style="@(!_isPaused ? "opacity:.5;pointer-events:none" : "")">
            <h2>Formation</h2>
            <div class="page-actions" style="margin-bottom:1rem">
                @foreach (var f in FootballManagerSimulator.Maui.Helpers.TacticHelper.Formations)
                {
                    <button class="btn @(Engine.MyClub.Formation == f ? "btn-primary" : "")"
                            disabled="@(!_isPaused)"
                            @onclick="() => { Engine.ChangeFormation(f); OnLineupChanged(); }">@f</button>
                }
            </div>
        </div>

        <div class="panel" style="@(!_isPaused ? "opacity:.5;pointer-events:none" : "")">
            <h2>Squad @(_isPaused ? "(tap to swap)" : "")</h2>
            @{
                var starters = Engine.MyClub.TacticSlots.Where(s => s.TacticSlotType != TacticSlotType.SUB && s.TacticSlotType != TacticSlotType.RES).ToList();
                var subs = Engine.MyClub.TacticSlots.Where(s => s.TacticSlotType == TacticSlotType.SUB).ToList();
            }
            <table class="data">
                <tbody>
                    @for (var i = 0; i < starters.Count; i++)
                    {
                        var idx = Engine.MyClub.TacticSlots.IndexOf(starters[i]);
                        var slot = starters[i];
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        <tr class="@(_isPaused ? "clickable" : "") @(_selectedSlot == idx ? "highlight" : "")"
                            @onclick="() => OnSlotClick(idx)">
                            <td style="width:70px"><span class="pos-chip @Ui.PositionCssClass(slot.TacticSlotType.ToString())">@slot.TacticSlotType</span></td>
                            <td>@(player?.Name ?? "— empty —")</td>
                            <td class="num" style="width:50px">@(player?.Rating.ToString() ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3 style="margin-top:1rem">Substitutions</h3>
            <table class="data">
                <tbody>
                    @for (var i = 0; i < subs.Count; i++)
                    {
                        var idx = Engine.MyClub.TacticSlots.IndexOf(subs[i]);
                        var slot = subs[i];
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        var posLabel = player?.Position ?? "SUB";
                        <tr class="@(_isPaused ? "clickable" : "") @(_selectedSlot == idx ? "highlight" : "")"
                            @onclick="() => OnSlotClick(idx)">
                            <td style="width:70px"><span class="pos-chip @Ui.PositionCssClass(posLabel)">@posLabel</span></td>
                            <td>@(player?.Name ?? "— empty —")</td>
                            <td class="num" style="width:50px">@(player?.Rating.ToString() ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_tab == 3)
    {
        var otherFixtures = Engine.TodaysFixtures()
            .Where(f => f != _fixture)
            .ToList();
        if (!otherFixtures.Any())
        {
            <p class="muted">No other matches in progress today.</p>
        }
        else
        {
            var grouped = otherFixtures
                .Select(f => new { Fixture = f, Competition = Engine.GetCompetitionForFixture(f) })
                .GroupBy(x => x.Competition?.Id ?? 0)
                .OrderBy(g => g.Key);

            @foreach (var group in grouped)
            {
                <div class="fixture-block">
                    <div class="fixture-block-head">@(group.First().Competition?.Name ?? "Other")</div>
                    @foreach (var item in group)
                    {
                        var f = item.Fixture;
                        var liveHome = f.HomeScorers.Count(g => g.Minute <= _currentMinute);
                        var liveAway = f.AwayScorers.Count(g => g.Minute <= _currentMinute);
                        <div class="fixture-row">
                            <div class="fixture-row-border"></div>
                            <div class="fixture-row-inner">
                                <span class="fixture-team home">@f.HomeClub.Name</span>
                                <span class="fixture-score"><strong>@liveHome - @liveAway</strong></span>
                                <span class="fixture-team away">@f.AwayClub.Name</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
    else if (_tab == 4)
    {
        var homeClub = Engine.GetClub(_fixture.HomeClub.Id);
        var awayClub = Engine.GetClub(_fixture.AwayClub.Id);

        <div class="panel">
            <h2>@_fixture.HomeClub.Name</h2>
            @if (homeClub != null)
            {
                var homeStarters = homeClub.TacticSlots.Take(11).ToList();
                <div class="pitch">
                    @for (var i = 0; i < homeStarters.Count; i++)
                    {
                        var slot = homeStarters[i];
                        var (x, y) = PitchPosition(homeStarters, i);
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        <div class="pitch-player" style="left:@(x)%;top:@(y)%">
                            <div class="dot">@slot.TacticSlotType</div>
                            <div class="pname">@(player != null ? Surname(player.Name) : "—")</div>
                        </div>
                    }
                </div>
            }

            <h2 style="margin-top:2rem">@_fixture.AwayClub.Name</h2>
            @if (awayClub != null)
            {
                var awayStarters = awayClub.TacticSlots.Take(11).ToList();
                <div class="pitch">
                    @for (var i = 0; i < awayStarters.Count; i++)
                    {
                        var slot = awayStarters[i];
                        var (x, y) = PitchPosition(awayStarters, i);
                        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
                        <div class="pitch-player" style="left:@(x)%;top:@(y)%">
                            <div class="dot">@slot.TacticSlotType</div>
                            <div class="pname">@(player != null ? Surname(player.Name) : "—")</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private enum MatchPhase { FirstHalf, HalfTime, SecondHalf, FullTime, ExtraTime, ExtraTimeBreak, PenaltiesBreak, Concluded }

    private record MatchEvent(int Minute, string Icon, string Description, string CssClass);

    private int _tab;
    private FixtureModel? _fixture;
    private ICompetition? _competition;

    private string CompetitionHeading(ICompetition competition)
    {
        var settings = SettingsOptions.Value;
        var config = settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }
    private Timer? _timer;
    private int _currentMinute;
    private int _displayedHomeGoals;
    private int _displayedAwayGoals;
    private bool _isPaused;
    private MatchPhase _phase = MatchPhase.FirstHalf;
    private readonly List<MatchEvent> _eventFeed = new();
    private int _revealedHomeGoals;
    private int _revealedAwayGoals;
    private int _revealedHomeCards;
    private int _revealedAwayCards;
    private int? _selectedSlot;

    protected override void OnInitialized()
    {
        _fixture = Engine.MyFixtureToday();
        if (_fixture == null) return;

        _competition = Engine.GetCompetitionForFixture(_fixture);

        var resumeMinute = _fixture.Minute;
        if (resumeMinute > 0)
        {
            _currentMinute = resumeMinute;
            _displayedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
            _displayedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
            _revealedHomeGoals = _displayedHomeGoals;
            _revealedAwayGoals = _displayedAwayGoals;
            _revealedHomeCards = _fixture.HomeCards.Count(c => c.Minute <= _currentMinute);
            _revealedAwayCards = _fixture.AwayCards.Count(c => c.Minute <= _currentMinute);

            _eventFeed.Add(new MatchEvent(0, "🟢", "Kick Off!", ""));
            RebuildEventFeed();

            if (_fixture.Concluded)
            {
                _phase = MatchPhase.Concluded;
                _isPaused = true;
            }
            else if (_currentMinute >= 120)
            {
                _phase = MatchPhase.Concluded;
                _isPaused = true;
            }
            else if (_currentMinute >= 90)
            {
                _phase = MatchPhase.ExtraTime;
                _isPaused = true;
            }
            else if (_currentMinute >= 45)
            {
                _phase = MatchPhase.SecondHalf;
                _isPaused = true;
            }
            else
            {
                _phase = MatchPhase.FirstHalf;
                _isPaused = true;
            }
        }
        else
        {
            _currentMinute = 0;
            _displayedHomeGoals = 0;
            _displayedAwayGoals = 0;
            _phase = MatchPhase.FirstHalf;
            _eventFeed.Add(new MatchEvent(0, "🟢", "Kick Off!", ""));
        }

        var speed = Engine.State.MatchSpeedMs;
        _timer = new Timer(OnTick, null, speed, speed);
    }

    private void RebuildEventFeed()
    {
        if (_fixture == null) return;

        var events = new List<(int Minute, MatchEvent Event)>();

        foreach (var g in _fixture.HomeScorers.Where(g => g.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(g.PlayerId);
            events.Add((g.Minute, new MatchEvent(g.Minute, "⚽", $"GOAL! {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", "event-goal")));
        }
        foreach (var g in _fixture.AwayScorers.Where(g => g.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(g.PlayerId);
            events.Add((g.Minute, new MatchEvent(g.Minute, "⚽", $"GOAL! {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", "event-goal")));
        }
        foreach (var c in _fixture.HomeCards.Where(c => c.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(c.PlayerId);
            var icon = c.IsRed ? "🟥" : "🟨";
            var type = c.IsRed ? "Red card" : "Yellow card";
            events.Add((c.Minute, new MatchEvent(c.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", c.IsRed ? "event-red" : "event-yellow")));
        }
        foreach (var c in _fixture.AwayCards.Where(c => c.Minute <= _currentMinute))
        {
            var player = Engine.GetPlayer(c.PlayerId);
            var icon = c.IsRed ? "🟥" : "🟨";
            var type = c.IsRed ? "Red card" : "Yellow card";
            events.Add((c.Minute, new MatchEvent(c.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", c.IsRed ? "event-red" : "event-yellow")));
        }

        foreach (var e in events.OrderBy(e => e.Minute))
            _eventFeed.Add(e.Event);
    }

    private async void OnTick(object? state)
    {
        if (_isPaused) return;

        _currentMinute++;
        RevealEvents();

        var targetMinute = _phase switch
        {
            MatchPhase.FirstHalf => 45,
            MatchPhase.SecondHalf => 90,
            MatchPhase.ExtraTime => 120,
            _ => 90
        };

        if (_currentMinute >= targetMinute)
        {
            _currentMinute = targetMinute;
            _isPaused = true;
            TransitionPhase();
        }

        _fixture!.Minute = _currentMinute;
        _fixture.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;

        await InvokeAsync(StateHasChanged);
    }

    private void RevealEvents()
    {
        if (_fixture == null) return;

        var homeGoalsToReveal = _fixture.HomeScorers
            .Where(g => g.Minute <= _currentMinute)
            .OrderBy(g => g.Minute)
            .Skip(_revealedHomeGoals)
            .ToList();

        foreach (var goal in homeGoalsToReveal)
        {
            var player = Engine.GetPlayer(goal.PlayerId);
            _eventFeed.Add(new MatchEvent(goal.Minute, "⚽", $"GOAL! {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", "event-goal"));
            _revealedHomeGoals++;
        }

        var awayGoalsToReveal = _fixture.AwayScorers
            .Where(g => g.Minute <= _currentMinute)
            .OrderBy(g => g.Minute)
            .Skip(_revealedAwayGoals)
            .ToList();

        foreach (var goal in awayGoalsToReveal)
        {
            var player = Engine.GetPlayer(goal.PlayerId);
            _eventFeed.Add(new MatchEvent(goal.Minute, "⚽", $"GOAL! {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", "event-goal"));
            _revealedAwayGoals++;
        }

        var homeCardsToReveal = _fixture.HomeCards
            .Where(c => c.Minute <= _currentMinute)
            .OrderBy(c => c.Minute)
            .Skip(_revealedHomeCards)
            .ToList();

        foreach (var card in homeCardsToReveal)
        {
            var player = Engine.GetPlayer(card.PlayerId);
            var icon = card.IsRed ? "🟥" : "🟨";
            var type = card.IsRed ? "Red card" : "Yellow card";
            _eventFeed.Add(new MatchEvent(card.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.HomeClub.Name})", card.IsRed ? "event-red" : "event-yellow"));
            _revealedHomeCards++;
        }

        var awayCardsToReveal = _fixture.AwayCards
            .Where(c => c.Minute <= _currentMinute)
            .OrderBy(c => c.Minute)
            .Skip(_revealedAwayCards)
            .ToList();

        foreach (var card in awayCardsToReveal)
        {
            var player = Engine.GetPlayer(card.PlayerId);
            var icon = card.IsRed ? "🟥" : "🟨";
            var type = card.IsRed ? "Red card" : "Yellow card";
            _eventFeed.Add(new MatchEvent(card.Minute, icon, $"{type} - {player?.Name ?? "Unknown"} ({_fixture.AwayClub.Name})", card.IsRed ? "event-red" : "event-yellow"));
            _revealedAwayCards++;
        }

        _displayedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
        _displayedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
    }

    private void TransitionPhase()
    {
        _phase = _phase switch
        {
            MatchPhase.FirstHalf => MatchPhase.HalfTime,
            MatchPhase.SecondHalf => CheckFullTime(),
            MatchPhase.ExtraTime => CheckExtraTimeEnd(),
            _ => _phase
        };

        if (_phase == MatchPhase.FullTime || _phase == MatchPhase.Concluded)
            ConcludeMatch();
    }

    private MatchPhase CheckFullTime()
    {
        if ((_competition?.Type == CompetitionType.Cup || _competition?.Type == CompetitionType.EnglishCommunityShield) && _displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture!);
            return MatchPhase.ExtraTimeBreak;
        }

        if (_fixture?.FixtureType == FixtureType.PlayoffSecondLeg && _competition != null)
        {
            Engine.MatchSimulator.PopulateFirstLegScores(_fixture, _competition);
            var homeAgg = _displayedHomeGoals + (_fixture.FirstLegGoalsAway ?? 0);
            var awayAgg = _displayedAwayGoals + (_fixture.FirstLegGoalsHome ?? 0);
            if (homeAgg == awayAgg)
            {
                Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture);
                return MatchPhase.ExtraTimeBreak;
            }
        }

        if ((_fixture?.FixtureType == FixtureType.PlayoffFinal ||
             (_fixture?.FixtureType == FixtureType.Playoff && _competition?.Type == CompetitionType.EnglishNationalLeague))
            && _displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GenerateExtraTimeEvents(_fixture!);
            return MatchPhase.ExtraTimeBreak;
        }

        return MatchPhase.FullTime;
    }

    private MatchPhase CheckExtraTimeEnd()
    {
        if (_fixture?.FixtureType == FixtureType.PlayoffSecondLeg)
        {
            var homeAgg = _displayedHomeGoals + (_fixture.FirstLegGoalsAway ?? 0);
            var awayAgg = _displayedAwayGoals + (_fixture.FirstLegGoalsHome ?? 0);
            if (homeAgg == awayAgg)
            {
                Engine.MatchSimulator.GeneratePenaltyEvents(_fixture);
                return MatchPhase.PenaltiesBreak;
            }
            return MatchPhase.FullTime;
        }

        if (_displayedHomeGoals == _displayedAwayGoals)
        {
            Engine.MatchSimulator.GeneratePenaltyEvents(_fixture!);
            return MatchPhase.PenaltiesBreak;
        }
        return MatchPhase.FullTime;
    }

    private void ConcludeMatch()
    {
        if (_fixture == null) return;
        _fixture.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;
        Engine.FinalisePlayerMatch(_fixture);
    }

    private void ContinueFromBreak()
    {
        _phase = _phase switch
        {
            MatchPhase.HalfTime => MatchPhase.SecondHalf,
            MatchPhase.ExtraTimeBreak => MatchPhase.ExtraTime,
            _ => _phase
        };
        _isPaused = false;
    }

    private void StartPenalties()
    {
        _currentMinute = 121;
        RevealEvents();
        _fixture!.GoalsHome = _displayedHomeGoals;
        _fixture.GoalsAway = _displayedAwayGoals;
        _phase = MatchPhase.Concluded;
        ConcludeMatch();
        StateHasChanged();
    }

    private void GoToFullTime()
    {
        Nav.NavigateTo("/fulltime");
    }

    private void TogglePause()
    {
        _isPaused = !_isPaused;
        if (!_isPaused) _selectedSlot = null;
    }

    private void OnSlotClick(int index)
    {
        if (!_isPaused) return;
        if (_selectedSlot == null) { _selectedSlot = index; return; }
        if (_selectedSlot == index) { _selectedSlot = null; return; }
        Engine.SwapTacticSlots(_selectedSlot.Value, index);
        _selectedSlot = null;
        OnLineupChanged();
    }

    private void OnLineupChanged()
    {
        if (_fixture == null) return;
        Engine.MatchSimulator.ReGenerateFromMinute(_fixture, _currentMinute);

        _revealedHomeGoals = _fixture.HomeScorers.Count(g => g.Minute <= _currentMinute);
        _revealedAwayGoals = _fixture.AwayScorers.Count(g => g.Minute <= _currentMinute);
        _revealedHomeCards = _fixture.HomeCards.Count(c => c.Minute <= _currentMinute);
        _revealedAwayCards = _fixture.AwayCards.Count(c => c.Minute <= _currentMinute);

        _eventFeed.RemoveAll(e => e.Minute > _currentMinute);
    }

    private string PhaseCaption() => _phase switch
    {
        MatchPhase.FirstHalf => $"{_currentMinute}'",
        MatchPhase.HalfTime => "Half Time",
        MatchPhase.SecondHalf => $"{_currentMinute}'",
        MatchPhase.FullTime => "Full Time",
        MatchPhase.ExtraTime => $"{_currentMinute}' (ET)",
        MatchPhase.ExtraTimeBreak => "Extra Time",
        MatchPhase.PenaltiesBreak => "Penalties",
        MatchPhase.Concluded => "Full Time",
        _ => ""
    };

    private static string Surname(string name)
    {
        var parts = name.Split(' ');
        return parts.Length > 1 ? parts[^1] : name;
    }

    private static (double x, double y) PitchPosition(List<TacticSlotModel> starters, int index)
    {
        var line = LineOf(starters[index].TacticSlotType);
        var sameLine = starters.Select((s, i) => (s, i)).Where(t => LineOf(t.s.TacticSlotType) == line)
            .OrderBy(t => SideOrder(t.s.TacticSlotType)).ToList();
        var posInLine = sameLine.FindIndex(t => t.i == index);
        var count = sameLine.Count;
        var spread = count >= 4 ? 70.0 : count == 3 ? 50.0 : 30.0;
        var x = count == 1 ? 50.0 : (50.0 - spread / 2) + posInLine * (spread / (count - 1));
        var y = line switch { 0 => 90.0, 1 => 72.0, 2 => 60.0, 3 => 46.0, 4 => 30.0, _ => 14.0 };
        return (x, y);
    }

    private static int SideOrder(TacticSlotType type) => type switch
    {
        TacticSlotType.LB or TacticSlotType.LM or TacticSlotType.LW or TacticSlotType.LF or TacticSlotType.LS => 0,
        TacticSlotType.RB or TacticSlotType.RM or TacticSlotType.RW => 2,
        _ => 1
    };

    private static int LineOf(TacticSlotType type) => type switch
    {
        TacticSlotType.GK => 0,
        TacticSlotType.RB or TacticSlotType.LB or TacticSlotType.CB => 1,
        TacticSlotType.CDM => 2,
        TacticSlotType.RM or TacticSlotType.LM or TacticSlotType.CM => 3,
        TacticSlotType.CAM => 4,
        _ => 5
    };

    private static readonly Dictionary<string, string> ColourMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Red"] = "#d32f2f", ["Blue"] = "#1565c0", ["White"] = "#e8e8e8", ["Black"] = "#1a1a1a",
        ["Yellow"] = "#f9a825", ["Green"] = "#2e7d32", ["Navy"] = "#1a237e", ["Sky Blue"] = "#4fc3f7",
        ["Light Blue"] = "#4fc3f7", ["Claret"] = "#7b1f3a", ["Maroon"] = "#7b1f3a", ["Amber"] = "#ff8f00",
        ["Gold"] = "#ffc107", ["Orange"] = "#e65100", ["Tangerine"] = "#ff6d00", ["Purple"] = "#7b1fa2",
    };

    private static string ToHex(string name) =>
        ColourMap.TryGetValue(name.Trim(), out var hex) ? hex : "#15c47e";

    private static bool IsLight(string hex)
    {
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
    }

    private static string CrestStyle(string colour)
    {
        if (string.IsNullOrWhiteSpace(colour)) return "";
        var parts = colour.Split('/');
        if (parts.Length == 1)
        {
            var hex = ToHex(parts[0]);
            var textCol = IsLight(hex) ? "#111" : "#fff";
            return $"background:{hex};color:{textCol}";
        }
        var hexes = parts.Select(p => ToHex(p)).ToArray();
        var stripeWidth = 6;
        var stops = new List<string>();
        for (var i = 0; i < hexes.Length; i++)
        {
            stops.Add($"{hexes[i]} {i * stripeWidth}px");
            stops.Add($"{hexes[i]} {(i + 1) * stripeWidth}px");
        }
        var textCol2 = IsLight(hexes[0]) ? "#111" : "#fff";
        return $"background:repeating-linear-gradient(90deg,{string.Join(",", stops)});color:{textCol2};text-shadow:0 1px 2px rgba(0,0,0,0.5)";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
