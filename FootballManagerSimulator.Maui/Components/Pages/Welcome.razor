@page "/"
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Football Manager Simulator</PageTitle>

<div class="menu-card">
    <div class="brand">
        <div class="brand-badge">⚽</div>
        <h1>Football Manager</h1>
        <p>Simulator</p>
    </div>

    <div class="menu-actions">
        <button class="btn btn-primary btn-lg btn-block" @onclick="StartNew">Start New Game</button>
        <button class="btn btn-lg btn-block" @onclick="@(() => Nav.NavigateTo("/load"))">Load Game</button>
        @if (Engine.GameInProgress)
        {
            <button class="btn btn-ghost btn-block" @onclick="@(() => Nav.NavigateTo("/game"))">Resume Current Game</button>
        }
    </div>
</div>

@code {
    private void StartNew()
    {
        Engine.StartNewGame();
        Nav.NavigateTo("/new");
    }
}
