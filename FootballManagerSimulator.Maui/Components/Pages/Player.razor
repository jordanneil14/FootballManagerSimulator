@page "/player/{Id:int}"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Player</PageTitle>

@{
    var player = Engine.GetPlayer(Id);
}

@if (player == null)
{
    <p class="muted">Player not found.</p>
}
else
{
    var club = player.Contract == null ? "Free Agent" : Engine.GetClub(player.Contract.ClubId)?.Name ?? "Free Agent";
    var playsForMe = Engine.PlayerPlaysForMyClub(player.Id);
    var retiring = Engine.IsPlayerRetiring(player);

    <div class="page-head">
        <div>
            <h1>@player.Name</h1>
            <div class="subtitle">
                <span class="pos-chip @Ui.PositionCssClass(player.PreferredPosition)">@player.PreferredPosition</span>
                @club · @player.Nationality
            </div>
        </div>
        <div class="page-actions">
            @if (_message != null) { <span class="tag green">@_message</span> }
            @if (playsForMe)
            {
                <a class="btn btn-primary" href="@($"/transfers/player/{player.Id}")">Transfer Options</a>
            }
            else if (Engine.IsUnemployed)
            {
                // No club to sign players for.
            }
            else if (retiring)
            {
                <span class="tag">Retiring</span>
            }
            else if (player.Contract == null)
            {
                <button class="btn btn-primary" @onclick="() => _showSignModal = true">Sign Free Agent</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="OpenBidModal">Buy Player</button>
            }
        </div>
    </div>

    @if (Engine.IsPlayerTransferListed(player.Id))
    {
        <div class="feedback"><div class="feedback-item">This player is transfer listed for @(Engine.GetTransferListItem(player.Id)?.AskingPriceFriendly).</div></div>
    }

    @if (retiring)
    {
        <div class="feedback"><div class="feedback-item warn">@player.Name will not sign a new contract and will retire @(player.Contract == null ? "at the end of the season" : "when his contract expires").</div></div>
    }

    <div class="stat-row">
        <div class="stat"><div class="label">Overall</div><div class="value accent">@player.Rating</div></div>
        <div class="stat"><div class="label">Age</div><div class="value">@player.GetAge(Engine.State.Date)</div></div>
    </div>

    <div class="stat-row">
        <div class="stat"><div class="label">Transfer Value</div><div class="value">@Ui.Money(Engine.GetTransferValue(player))</div></div>
    </div>

    <div class="grid grid-2">
        <div class="panel">
            <h2>General</h2>
            <dl class="kv">
                <dt>Birth Date</dt><dd>@player.BirthDate</dd>
                <dt>Height</dt><dd>@player.Height</dd>
                <dt>Weight</dt><dd>@player.Weight</dd>
                <dt>Nationality</dt><dd>@player.Nationality</dd>
                <dt>Preferred Foot</dt><dd>@player.PreferredFoot</dd>
                <dt>Work Rate</dt><dd>@player.WorkRate</dd>
                @if (player.Contract != null)
                {
                    <dt>Contract Until</dt><dd>@player.Contract.ExpiryDate.ToString("dd MMM yyyy")</dd>
                }
            </dl>
        </div>

        <div class="panel">
            <h2>@(player.PreferredPosition == "GK" ? "Goalkeeping" : "Attributes")</h2>
            <div class="attr-grid">
                @if (player.PreferredPosition == "GK")
                {
                    @Attr("Positioning", player.GKPositioning)
                    @Attr("Diving", player.GKDiving)
                    @Attr("Kicking", player.GKKicking)
                    @Attr("Handling", player.GKHandling)
                    @Attr("Reflexes", player.GKReflexes)
                }
                else
                {
                    @Attr("Ball Control", player.BallControl)
                    @Attr("Dribbling", player.Dribbling)
                    @Attr("Finishing", player.Finishing)
                    @Attr("Shot Power", player.ShotPower)
                    @Attr("Long Shots", player.LongShots)
                    @Attr("Short Pass", player.ShortPass)
                    @Attr("Long Pass", player.LongPass)
                    @Attr("Crossing", player.Crossing)
                    @Attr("Acceleration", player.Acceleration)
                    @Attr("Speed", player.Speed)
                    @Attr("Agility", player.Agility)
                    @Attr("Stamina", player.Stamina)
                    @Attr("Strength", player.Strength)
                    @Attr("Heading", player.Heading)
                    @Attr("Marking", player.Marking)
                    @Attr("Tackling", player.SlidingTackle)
                    @Attr("Aggression", player.Aggression)
                    @Attr("Vision", player.Vision)
                    @Attr("Composure", player.Composure)
                    @Attr("Penalties", player.Penalties)
                }
            </div>
        </div>
    </div>
}

@if (_showSignModal)
{
    var p = Engine.GetPlayer(Id);
    <div class="modal-overlay" @onclick="() => _showSignModal = false">
        <div class="modal" @onclick:stopPropagation>
            <h2>Sign Free Agent</h2>
            <p>@(p?.Name ?? "This player") would like to join your club.</p>
            <div style="margin-bottom:1rem">
                <label class="label">Contract Length</label>
                <select class="input" @bind="_contractYears">
                    @for (var y = 1; y <= 5; y++)
                    {
                        <option value="@y">@y @(y == 1 ? "year" : "years")</option>
                    }
                </select>
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _showSignModal = false">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmSignFreeAgent">Confirm</button>
            </div>
        </div>
    </div>
}

@if (_showBidModal)
{
    var p = Engine.GetPlayer(Id);
    <div class="modal-overlay" @onclick="CloseBidModal">
        <div class="modal" @onclick:stopPropagation>
            <h2>Make a Bid</h2>
            <p>Submit an offer to <strong>@(p?.Contract?.ClubName ?? "the club")</strong> for <strong>@(p?.Name ?? "this player")</strong>.</p>
            <div class="stat-row" style="margin-bottom:.5rem">
                <div class="stat"><div class="label">Transfer Value</div><div class="value">@Ui.Money(Engine.GetTransferValue(p!))</div></div>
            </div>
            <div class="stat-row" style="margin-bottom:1rem">
                <div class="stat"><div class="label">Your Budget</div><div class="value">@Ui.Money(Engine.MyClub.TransferBudget)</div></div>
            </div>
            @if (_bidResponse != null)
            {
                <div class="feedback" style="margin-bottom:1rem">
                    <div class="feedback-item @(_bidResult?.Accepted == true ? "good" : "warn")">@_bidResponse</div>
                </div>
            }
            @if (_bidResult?.Accepted != true)
            {
                <div style="margin-bottom:1rem">
                    <label class="label">Bid Amount (£)</label>
                    <input class="input" type="number" @bind="_bidAmount" min="0" step="100000" />
                </div>
                @if (_bidResult?.CounterOffer > 0)
                {
                    <div class="modal-actions">
                        <button class="btn" @onclick="CloseBidModal">Walk Away</button>
                        <button class="btn" @onclick="SubmitBid">New Bid</button>
                        <button class="btn btn-primary" @onclick="AcceptCounter">Accept @Ui.Money(_bidResult.CounterOffer)</button>
                    </div>
                }
                else
                {
                    <div class="modal-actions">
                        <button class="btn" @onclick="CloseBidModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SubmitBid">Submit Bid</button>
                    </div>
                }
            }
            else
            {
                <div style="margin-bottom:1rem">
                    <label class="label">Contract Length</label>
                    <select class="input" @bind="_contractYears">
                        @for (var y = 1; y <= 5; y++)
                        {
                            <option value="@y">@y @(y == 1 ? "year" : "years")</option>
                        }
                    </select>
                </div>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseBidModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="CompletePurchase">Confirm Signing</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private string? _message;
    private bool _showSignModal;
    private bool _showBidModal;
    private int _contractYears = 2;
    private int _bidAmount;
    private int _agreedFee;
    private string? _bidResponse;
    private BidResultModel? _bidResult;

    private void ConfirmSignFreeAgent()
    {
        _showSignModal = false;
        _message = Engine.SignFreeAgent(Id, _contractYears);
    }

    private void OpenBidModal()
    {
        var player = Engine.GetPlayer(Id);
        if (player == null) return;
        _bidAmount = Engine.GetTransferValue(player);
        _bidResponse = null;
        _bidResult = null;
        _showBidModal = true;
    }

    private void CloseBidModal()
    {
        _showBidModal = false;
        _bidResponse = null;
        _bidResult = null;
    }

    private void SubmitBid()
    {
        _bidResult = Engine.SubmitBid(Id, _bidAmount);
        _bidResponse = _bidResult.Message;
        if (_bidResult.Accepted)
            _agreedFee = _bidAmount;
    }

    private void AcceptCounter()
    {
        _agreedFee = _bidResult!.CounterOffer;
        _bidResult = Engine.SubmitBid(Id, _agreedFee);
        _bidResponse = _bidResult.Message;
    }

    private void CompletePurchase()
    {
        _showBidModal = false;
        _message = Engine.CompletePurchase(Id, _agreedFee, _contractYears);
    }

    private RenderFragment Attr(string name, int value) => builder =>
    {
        var cls = value >= 80 ? "aval hi" : value >= 70 ? "aval mid" : "aval";
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "attr");
        builder.OpenElement(2, "span");
        builder.AddContent(3, name);
        builder.CloseElement();
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", cls);
        builder.AddContent(6, value);
        builder.CloseElement();
        builder.CloseElement();
    };
}
