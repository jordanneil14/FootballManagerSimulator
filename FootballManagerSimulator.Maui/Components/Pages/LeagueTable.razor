@page "/league-table"
@page "/league-table/{Id:int}"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Competitions</PageTitle>

@{
    var selectedId = Id ?? Engine.CurrentClub?.LeagueId ?? Engine.Leagues.OrderBy(p => p.Rank).FirstOrDefault()?.Id ?? 0;
    var competition = Engine.State.Competitions.FirstOrDefault(p => p.Id == selectedId);
    var league = competition as LeagueModel;
    var cup = competition as CupModel;
}

<div class="page-head">
    <div>
        <h1>@CountryFlag(selectedId) @(competition?.Name ?? "Competitions")</h1>
        <div class="subtitle">@(league != null ? "Standings" : "Draw")</div>
    </div>
</div>

<div class="league-select">
    <select class="input" value="@selectedId" @onchange='e => Nav.NavigateTo($"/league-table/{e.Value}")' aria-label="Competition">
        @foreach (var l in Engine.Leagues.OrderBy(p => p.Rank))
        {
            <option value="@l.Id" selected="@(l.Id == selectedId)">@CountryName(l.Id) - @l.Name</option>
        }
        @foreach (var c in Engine.State.Competitions.Where(p => !p.IsLeague && p.Type != CompetitionType.Friendly))
        {
            <option value="@c.Id" selected="@(c.Id == selectedId)">@CompetitionLabel(c)</option>
        }
    </select>
</div>

@if (league != null)
{
    var table = league.GenerateLeagueTable().ToList();
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th class="num">#</th><th>Club</th>
                    <th class="num">Pld</th><th class="num">Pts</th>
                    <th class="num">F</th><th class="num">A</th><th class="num">GD</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < table.Count; i++)
                {
                    var row = table[i];
                    var isMine = row.Club.Id == Engine.State.MyClubId;
                    <tr class="clickable @(isMine ? "highlight" : "") @ZoneClass(i + 1, league.Id)" @onclick='() => Nav.NavigateTo($"/club/{row.Club.Id}")'>
                        <td class="num">@(i + 1)</td>
                        <td><strong>@row.Club.Name</strong></td>
                        <td class="num">@row.Played</td>
                        <td class="num"><strong>@row.Points</strong></td>
                        <td class="num">@row.GoalsScored</td>
                        <td class="num">@row.GoalsConceded</td>
                        <td class="num">@row.GoalDifference</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="spread" style="margin-top:1rem">
        <span class="tag green">Promotion</span>
        <span class="tag" style="background:rgba(72,146,229,.18);color:#7fb2ff">Play-offs</span>
        <span class="tag red">Relegation</span>
    </div>
}
else if (cup != null)
{
    var rounds = cup.Fixtures
        .GroupBy(f => f.Round)
        .OrderBy(g => g.Key)
        .ToList();

    @if (!rounds.Any())
    {
        <p class="muted">No fixtures drawn yet.</p>
    }
    else
    {
        @foreach (var round in rounds)
        {
            <div class="fixture-block">
                <div class="fixture-block-head">Round @round.Key</div>
                @foreach (var f in round.OrderBy(f => f.Date).ThenBy(f => f.KickOffTime))
                {
                    var mine = f.HomeClub.Id == Engine.State.MyClubId || f.AwayClub.Id == Engine.State.MyClubId;
                    <div class="fixture-row @(mine ? "mine" : "")">
                        <div class="fixture-row-border"></div>
                        <div class="fixture-row-inner">
                            <span class="fixture-team home">@f.HomeClub.Name</span>
                            <span class="fixture-score">
                                @if (f.Concluded)
                                {
                                    <strong>@f.GoalsHome - @f.GoalsAway</strong>
                                }
                                else
                                {
                                    <span class="fixture-time">@f.Date.ToString("dd MMM")</span>
                                }
                            </span>
                            <span class="fixture-team away">@f.AwayClub.Name</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
}
else
{
    <p class="muted">Competition not found.</p>
}

@code {
    [Parameter] public int? Id { get; set; }

    private SettingsModel Settings => SettingsOptions.Value;

    private static readonly Dictionary<string, string> CountryFlags = new(StringComparer.OrdinalIgnoreCase)
    {
        ["England"] = "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
        ["Spain"] = "🇪🇸",
        ["Germany"] = "🇩🇪",
        ["Italy"] = "🇮🇹",
        ["France"] = "🇫🇷",
        ["Portugal"] = "🇵🇹",
        ["Scotland"] = "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
        ["Belgium"] = "🇧🇪",
        ["Netherlands"] = "🇳🇱",
        ["Turkey"] = "🇹🇷",
    };

    private string CountryFlag(int competitionId)
    {
        var name = CountryName(competitionId);
        return CountryFlags.TryGetValue(name, out var flag) ? flag : "🏳️";
    }

    private string CountryName(int competitionId)
    {
        var countryId = Settings.Competitions.FirstOrDefault(p => p.Id == competitionId)?.CountryId;
        return Settings.Countries.FirstOrDefault(c => c.Id == countryId)?.Name ?? "";
    }

    private string CompetitionLabel(ICompetition competition)
    {
        var country = CountryName(competition.Id);
        return string.IsNullOrEmpty(country) ? competition.Name : $"{country} - {competition.Name}";
    }

    private string ZoneClass(int position, int leagueId)
    {
        var cfg = Settings.Competitions.FirstOrDefault(p => p.Id == leagueId)?.LeagueTable;
        if (cfg == null) return "";
        if (position <= cfg.AutomaticPromotionPlaces) return "zone-promo";
        if (position <= cfg.AutomaticPromotionPlaces + cfg.PlayoffPlaces) return "zone-playoff";
        if (position > cfg.Places - cfg.RelegationPlaces) return "zone-releg";
        return "";
    }
}
