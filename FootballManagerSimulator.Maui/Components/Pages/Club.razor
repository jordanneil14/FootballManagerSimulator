@page "/club/{Id:int}"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Club</PageTitle>

@{
    var club = Engine.GetClub(Id);
}

@if (club == null)
{
    <p class="muted">Club not found.</p>
}
else
{
    var isMine = club.Id == Engine.State.MyClubId;
    var squad = Engine.State.Players.Where(p => p.Contract != null && p.Contract.ClubId == club.Id).ToList();

    <div class="page-head">
        <div>
            <h1>@Ui.CountryFlag(CountryName(club.LeagueId)) @club.Name @if (isMine) { <span class="tag green">Your Club</span> }</h1>
            <div class="subtitle">🏟️ @club.Stadium · 🏆 @LeagueName(club.LeagueId)</div>
        </div>
    </div>

    <div class="panel">
        <h2>Recent Fixtures &amp; Results</h2>
        @{
            var clubFixtures = Engine.State.Competitions.SelectMany(c => c.Fixtures)
                .Where(f => f.HomeClub.Id == club.Id || f.AwayClub.Id == club.Id)
                .ToList();
            var recent = clubFixtures.Where(f => f.Concluded).OrderBy(f => f.Date).TakeLast(2);
            var upcoming = clubFixtures.Where(f => !f.Concluded && f.Date >= Engine.State.Date).OrderBy(f => f.Date).Take(3);
            var recentFixtures = recent.Concat(upcoming).ToList();
        }
        @if (!recentFixtures.Any()) { <p class="muted">No fixtures to show.</p> }
        else
        {
            <table class="data fixture-table">
                <tbody>
                    @foreach (var f in recentFixtures)
                    {
                        <tr>
                            <td style="text-align:right"><strong>@f.HomeClub.Name</strong></td>
                            <td class="center">
                                @if (f.Concluded)
                                {
                                    <strong class="num">@f.GoalsHome&nbsp;-&nbsp;@f.GoalsAway</strong>
                                }
                                else
                                {
                                    <span class="muted">@f.KickOffTime.ToString("HH:mm")</span>
                                }
                                <div class="muted" style="font-size:.72rem">@f.Date.ToString("ddd dd MMM")</div>
                            </td>
                            <td><strong>@f.AwayClub.Name</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="panel">
        <h2>Squad <span class="panel-title-sub">@squad.Count players</span></h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th class="num">#</th><th>Pos</th><th>Name</th><th class="num">Rating</th><th class="num">Value</th><th>Contract</th></tr>
                </thead>
                <tbody>
                    @foreach (var player in squad.OrderBy(p => Ui.PositionSortOrder(p.PreferredPosition)).ThenByDescending(p => p.Rating))
                    {
                        <tr class="clickable" @onclick='() => Nav.NavigateTo($"/player/{player.Id}")'>
                            <td class="num">@player.ShirtNumber</td>
                            <td><span class="pos-chip @Ui.PositionCssClass(player.PreferredPosition)">@player.PreferredPosition</span></td>
                            <td><strong>@player.Name</strong></td>
                            <td class="num"><span class="@Ui.RatingCssClass(player.Rating)">@player.Rating</span></td>
                            <td class="num">@Ui.Money(Engine.GetTransferValue(player))</td>
                            <td class="muted">@player.Contract!.ExpiryDate.ToString("MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private string? CountryName(int leagueId)
    {
        var countryId = SettingsOptions.Value.Competitions.FirstOrDefault(p => p.Id == leagueId)?.CountryId;
        return SettingsOptions.Value.Countries.FirstOrDefault(c => c.Id == countryId)?.Name;
    }

    private string LeagueName(int leagueId)
    {
        var name = Engine.State.Competitions.FirstOrDefault(p => p.Id == leagueId)?.Name ?? "";
        var country = CountryName(leagueId);
        return string.IsNullOrEmpty(country) ? name : $"{country} - {name}";
    }
}
