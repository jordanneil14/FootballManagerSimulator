@page "/load"
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Load Game</PageTitle>

<div class="menu-card wide">
    <div class="brand"><h1>Load Game</h1></div>

    @if (_error != null)
    {
        <div class="feedback"><div class="feedback-item warn">@_error</div></div>
    }

    @if (_saves == null || _busy)
    {
        <div class="throbber-wrap"><div class="throbber"></div></div>
    }
    else if (!_saves.Any())
    {
        <p class="muted" style="text-align:center">No saved games were found.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Name</th><th>Club</th><th>Manager Name</th><th>Last Saved</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var save in _saves)
                    {
                        <tr class="clickable" @onclick="() => LoadSave(save.FileName)">
                            <td><strong>@(save.FileName.Replace(".fms", ""))</strong></td>
                            <td>@save.ClubName</td>
                            <td>@save.ManagerName</td>
                            <td class="muted">@save.SaveDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="num">→</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private List<LoadGamePreviewModel>? _saves;
    private string? _error;
    private bool _busy;

    // File work runs off the UI thread so the WebView can keep animating the throbber.
    protected override async Task OnInitializedAsync() =>
        _saves = await Task.Run(() => Engine.ListSaves().ToList());

    private async Task LoadSave(string fileName)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        StateHasChanged();

        _error = await Task.Run(() => Engine.LoadGame(fileName));
        if (_error == null)
        {
            Engine.NotifyChanged();
            Nav.NavigateTo("/game");
            return;
        }

        _busy = false;
    }
}
