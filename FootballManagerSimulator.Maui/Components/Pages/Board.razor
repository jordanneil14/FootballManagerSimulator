@page "/board"
@layout GameLayout
@inject GameEngine Engine
@inject IJobOfferHelper JobOffers
@inject NavigationManager Nav

<PageTitle>Board</PageTitle>

<div class="page-head"><div><h1>Board</h1><div class="subtitle">Finances &amp; budgets</div></div></div>

@if (_message != null)
{
    <div class="feedback"><div class="feedback-item">@_message</div></div>
}

<div class="grid grid-2">
    <div class="stat"><div class="label">Budget</div><div class="value accent">@Engine.MyClub.TransferBudgetFriendly</div></div>
    <div class="stat"><div class="label">Stadium Capacity</div><div class="value">@Engine.MyClub.StadiumSize.ToString("n0")</div></div>
    <div class="stat"><div class="label">Academy Rating</div><div class="value">@Engine.MyClub.AcademyRating / @AcademyRules.Max</div></div>
</div>

@{
    var confidence = Engine.State.BoardConfidence;
    var confidenceColour = confidence >= BoardConfidenceRules.StableFrom ? "var(--accent)"
        : confidence >= BoardConfidenceRules.UnderPressureFrom ? "var(--warn)"
        : "var(--danger)";
}

<div class="panel">
    <h2>🤝 Board Confidence</h2>
    <p>The board's faith in you as manager. It rises with wins and falls with defeats.</p>
    <div class="progress-bar">
        <div class="progress-bar-fill" style="width:@(confidence)%;background:@confidenceColour"></div>
    </div>
    <p style="font-size:.82rem;margin-top:.5rem">
        <strong style="color:@confidenceColour">@BoardConfidenceRules.Label(confidence)</strong> · @BoardConfidenceRules.Format(confidence)
    </p>
</div>

@{
    var budgetRequestPending = Engine.State.Events
        .OfType<FootballManagerSimulator.Maui.Events.IncreaseTransferBudgetRequestEvent>()
        .Any(e => !e.IsCompleted);
}

<div class="grid grid-2">
    <div class="panel">
        <h2>💷 Budget</h2>
        @if (budgetRequestPending)
        {
            <p>Your budget request is being reviewed by the board.</p>
        }
        else
        {
            <p>Request additional funds from the board. They will consider your request and respond within a couple of days.</p>
            <button class="btn btn-primary" @onclick="RequestBudget">Request a Higher Budget</button>
        }
    </div>
    <div class="panel">
        <h2>🏟️ Stadium Expansion</h2>
        @{
            var expansionEvent = Engine.StadiumExpansionInProgress;
            var expansionCost = Engine.NextStadiumExpansionCost;
        }
        @if (expansionEvent != null)
        {
            var startDate = expansionEvent.TriggerDate.AddMonths(-StadiumRules.UpgradeMonths);
            var totalDays = (double)(expansionEvent.TriggerDate.DayNumber - startDate.DayNumber);
            var progress = Math.Clamp((Engine.State.Date.DayNumber - startDate.DayNumber) / totalDays, 0, 1);
            var daysRemaining = expansionEvent.TriggerDate.DayNumber - Engine.State.Date.DayNumber;

            <p><strong>@Engine.MyClub.Stadium</strong> is being expanded to <strong>@((Engine.MyClub.StadiumSize + StadiumRules.SeatsAdded(Engine.MyClub.StadiumSize)).ToString("n0"))</strong> seats.</p>
            <div class="progress-bar">
                <div class="progress-bar-fill" style="width:@((int)(progress * 100))%"></div>
            </div>
            <p style="font-size:.82rem;margin-top:.5rem">
                <strong>@((int)(progress * 100))%</strong> complete · @daysRemaining days remaining
                · Completion: @expansionEvent.TriggerDate.ToString("dd MMM yyyy")
            </p>
        }
        else if (expansionCost == null)
        {
            <p><strong>@Engine.MyClub.Stadium</strong> is at the maximum capacity of <strong>@StadiumRules.MaxCapacity.ToString("n0")</strong>.</p>
        }
        else
        {
            <p>A bigger stadium grows matchday revenue. <strong>@Engine.MyClub.Stadium</strong> holds <strong>@Engine.MyClub.StadiumSize.ToString("n0")</strong>.</p>
            <p style="font-size:.82rem">Adding @StadiumRules.SeatsAdded(Engine.MyClub.StadiumSize).ToString("n0") seats costs <strong>@Ui.Money(expansionCost.Value)</strong> from the budget and takes @StadiumRules.UpgradeMonths months.</p>
            <button class="btn btn-primary" @onclick="ExpandStadium" disabled="@(expansionCost > Engine.MyClub.TransferBudget)">Expand Stadium</button>
        }
    </div>
    <div class="panel">
        <h2>🎓 Youth Academy</h2>
        @{
            var academyUpgrade = Engine.AcademyUpgradeInProgress;
            var upgradeCost = Engine.NextAcademyUpgradeCost;
        }
        @if (academyUpgrade != null)
        {
            var startDate = academyUpgrade.TriggerDate.AddMonths(-AcademyRules.UpgradeMonths);
            var totalDays = (double)(academyUpgrade.TriggerDate.DayNumber - startDate.DayNumber);
            var progress = Math.Clamp((Engine.State.Date.DayNumber - startDate.DayNumber) / totalDays, 0, 1);
            var daysRemaining = academyUpgrade.TriggerDate.DayNumber - Engine.State.Date.DayNumber;

            <p>The academy is being upgraded to <strong>@(Engine.MyClub.AcademyRating + 1) / @AcademyRules.Max</strong>.</p>
            <div class="progress-bar">
                <div class="progress-bar-fill" style="width:@((int)(progress * 100))%"></div>
            </div>
            <p style="font-size:.82rem;margin-top:.5rem">
                <strong>@((int)(progress * 100))%</strong> complete · @daysRemaining days remaining
                · Completion: @academyUpgrade.TriggerDate.ToString("dd MMM yyyy")
            </p>
        }
        else if (upgradeCost == null)
        {
            <p>Your academy is rated <strong>@Engine.MyClub.AcademyRating / @AcademyRules.Max</strong>, the best there is.</p>
        }
        else
        {
            <p>A better academy produces better players in the youth intake on 1 March. Your academy is rated <strong>@Engine.MyClub.AcademyRating / @AcademyRules.Max</strong>.</p>
            <p style="font-size:.82rem">Upgrading to @(Engine.MyClub.AcademyRating + 1) costs <strong>@Ui.Money(upgradeCost.Value)</strong> from the budget and takes @AcademyRules.UpgradeMonths months.</p>
            <button class="btn btn-primary" @onclick="UpgradeAcademy" disabled="@(upgradeCost > Engine.MyClub.TransferBudget)">Upgrade Academy</button>
        }
    </div>
    <div class="panel">
        <h2>🚪 Resign</h2>
        <p>Step down as manager of <strong>@Engine.MyClub.Name</strong>. You will be out of work until you take another job.</p>
        <button class="btn btn-danger" @onclick="() => _confirmResign = true">Resign</button>
    </div>
</div>

<ConfirmModal Visible="_confirmResign"
              Title="@($"Resign from {Engine.MyClub.Name}?")"
              Message="You will leave the club immediately. Any pending board requests and upgrades will be cancelled."
              OnConfirm="Resign"
              OnCancel="() => _confirmResign = false" />

@code {
    private string? _message;
    private void RequestBudget() => _message = Engine.RequestHigherTransferBudget();
    private void ExpandStadium() => _message = Engine.ExpandStadium();
    private void UpgradeAcademy() => _message = Engine.UpgradeAcademy();

    private bool _confirmResign;

    // After resigning there is no club to draw; the layout takes over until we've navigated away.
    protected override bool ShouldRender() => !Engine.IsUnemployed;

    private void Resign()
    {
        _confirmResign = false;
        JobOffers.ResignUser();
        Engine.NotifyChanged();
        Nav.NavigateTo("/game");
    }
}
