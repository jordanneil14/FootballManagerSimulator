@page "/jobs"
@layout GameLayout
@inject GameEngine Engine
@inject IJobOfferHelper JobOffers
@inject IReputationHelper Reputation
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Jobs</PageTitle>

@{
    var standings = Reputation.Standings();
    var reputation = Reputation.Reputation;
    var vacancies = JobOffers.Vacancies().ToList();
    var underThreat = JobOffers.ManagersUnderThreat().ToList();
    var applications = Engine.State.JobApplications.OrderBy(p => p.DecideOn).ToList();
}

<div class="page-head"><div><h1>Jobs</h1><div class="subtitle">Your reputation: <span style="color:var(--gold)">@JobRules.StarsText(reputation)</span> @JobRules.Format(reputation)</div></div></div>

<div class="panel">
    <h2>💼 Vacancies <span class="panel-title-sub">@vacancies.Count</span></h2>
    @if (!vacancies.Any())
    {
        <p class="muted">No clubs are looking for a manager right now.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Club</th><th>League</th><th>Standing</th><th>Your chance</th><th>Appointing by</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var club in vacancies)
                    {
                        var chance = JobOffers.ChanceFor(club, standings);
                        var refusal = JobOffers.ApplyRefusal(club, standings);
                        <tr>
                            <td><a href="/club/@club.Id"><strong>@club.Name</strong></a></td>
                            <td class="muted">@LeagueName(club.LeagueId)</td>
                            <td style="color:var(--gold)">@JobRules.StarsText(standings.GetValueOrDefault(club.Id))</td>
                            <td style="color:@JobRules.Colour(chance)">@JobRules.Label(chance)</td>
                            <td class="muted">@club.VacantUntil?.ToString("ddd dd MMM")</td>
                            <td class="num">
                                @if (JobOffers.ApplicationFor(club.Id) != null)
                                {
                                    <span class="muted">Applied</span>
                                }
                                else if (refusal == null)
                                {
                                    <button class="btn btn-primary" @onclick="() => _pendingClub = club">Apply</button>
                                }
                                else
                                {
                                    <span class="muted">@refusal</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (applications.Any())
{
    <div class="panel">
        <h2>📨 Your Applications <span class="panel-title-sub">@applications.Count</span></h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Club</th><th>Applied</th><th>Decision by</th></tr>
                </thead>
                <tbody>
                    @foreach (var application in applications)
                    {
                        var club = Engine.State.Clubs.FirstOrDefault(p => p.Id == application.ClubId);
                        <tr>
                            <td><a href="/club/@application.ClubId"><strong>@club?.Name</strong></a></td>
                            <td class="muted">@application.AppliedOn.ToString("ddd dd MMM")</td>
                            <td class="muted">@application.DecideOn.ToString("ddd dd MMM")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="panel">
    <h2>🔥 Managers Under Threat <span class="panel-title-sub">@underThreat.Count</span></h2>
    @if (!underThreat.Any())
    {
        <p class="muted">No managers are under threat right now.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Club</th><th>League</th><th>Standing</th><th>Your chance</th><th>Job security</th></tr>
                </thead>
                <tbody>
                    @foreach (var club in underThreat)
                    {
                        var chance = JobOffers.ChanceFor(club, standings);
                        <tr>
                            <td><a href="/club/@club.Id"><strong>@club.Name</strong></a></td>
                            <td class="muted">@LeagueName(club.LeagueId)</td>
                            <td style="color:var(--gold)">@JobRules.StarsText(standings.GetValueOrDefault(club.Id))</td>
                            <td style="color:@JobRules.Colour(chance)">@JobRules.Label(chance)</td>
                            <td style="color:var(--warn)">@BoardConfidenceRules.Label(club.JobSecurity)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<ConfirmModal Visible="_pendingClub != null"
              Title="@($"Apply to {_pendingClub?.Name}?")"
              Message="@ConfirmMessage()"
              OnConfirm="ConfirmApply"
              OnCancel="() => _pendingClub = null" />

@code {
    private ClubModel? _pendingClub;

    private string LeagueName(int leagueId)
    {
        var name = Engine.State.Competitions.FirstOrDefault(p => p.Id == leagueId)?.Name ?? "";
        var countryId = SettingsOptions.Value.Competitions.FirstOrDefault(p => p.Id == leagueId)?.CountryId;
        var country = SettingsOptions.Value.Countries.FirstOrDefault(c => c.Id == countryId)?.Name;
        return string.IsNullOrEmpty(country) ? name : $"{country} - {name}";
    }

    private string ConfirmMessage()
    {
        if (_pendingClub == null) return "";
        var chance = JobRules.Label(JobOffers.ChanceFor(_pendingClub));
        return $"Your chance: {chance}. {_pendingClub.Name} will let you know within a few days. If they offer you the job you can still turn it down.";
    }

    private void ConfirmApply()
    {
        if (_pendingClub == null) return;
        JobOffers.Apply(_pendingClub.Id);
        _pendingClub = null;
        Engine.NotifyChanged();
    }
}
