@page "/scout"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Scout</PageTitle>

<div class="page-head">
    <div><h1>Scout</h1><div class="subtitle">Search every player in the game</div></div>
</div>

<div class="panel">
    <h2 class="clickable" style="cursor:pointer;user-select:none" @onclick="() => _filtersOpen = !_filtersOpen">
        @(_filtersOpen ? "▾" : "▸") Filters
    </h2>
    @if (_filtersOpen)
    {
        <div class="inline-form">
            <div class="field">
                <label>Name or Club</label>
                <input class="input" style="width:240px" placeholder="Search…" value="@_search" @oninput="OnSearch" />
            </div>
            <div class="field">
                <label>Contract Status</label>
                <select class="input" style="width:180px" value="@_contractFilter" @onchange="OnContractFilterChanged">
                    <option value="All">All Players</option>
                    <option value="Contracted">Contracted</option>
                    <option value="FreeAgent">Free Agents</option>
                </select>
            </div>
        </div>
    }
</div>

@{
    var all = BuildPlayerList();
    var pageCount = Math.Max(1, (int)Math.Ceiling(all.Count / (double)PageSize));
    _page = Math.Clamp(_page, 1, pageCount);
    var pagePlayers = all.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
}

<div class="panel panel-fill">
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Pos</th><th>Name</th><th class="num">Rating</th><th>Club</th><th class="num">Value</th></tr>
            </thead>
            <tbody>
                @foreach (var player in pagePlayers)
                {
                    <tr class="clickable" @onclick='() => Nav.NavigateTo($"/player/{player.Id}")'>
                        <td><span class="pos-chip @Ui.PositionCssClass(player.PreferredPosition)">@player.PreferredPosition</span></td>
                        <td><strong>@player.Name</strong></td>
                        <td class="num"><span class="@Ui.RatingCssClass(player.Rating)">@player.Rating</span></td>
                        <td>@(player.Contract?.ClubName ?? "Free Agent")</td>
                        <td class="num">@Ui.Money(Engine.GetTransferValue(player))</td>
                    </tr>
                }
                @if (!pagePlayers.Any())
                {
                    <tr><td colspan="5" class="center muted">No players match your filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pager">
        <button class="btn" @onclick="() => _page--" disabled="@(_page <= 1)">← Prev</button>
        <span>Page @_page / @pageCount</span>
        <button class="btn" @onclick="() => _page++" disabled="@(_page >= pageCount)">Next →</button>
    </div>
</div>

@code {
    private bool _filtersOpen = true;
    private int _page = 1;
    private string _search = "";
    private string _contractFilter = "All";
    private const int PageSize = 20;

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnContractFilterChanged(ChangeEventArgs e)
    {
        _contractFilter = e.Value?.ToString() ?? "All";
        _page = 1;
    }

    private List<PlayerModel> BuildPlayerList()
    {
        IEnumerable<PlayerModel> players = _contractFilter switch
        {
            "Contracted" => Engine.State.Players
                .Where(p => p.Contract != null)
                .OrderBy(p => p.Contract!.ClubName)
                .ThenByDescending(p => p.Rating),
            "FreeAgent" => Engine.State.Players
                .Where(p => p.Contract == null)
                .OrderByDescending(p => p.Rating),
            _ => Engine.State.Players
                .Where(p => p.Contract != null)
                .OrderBy(p => p.Contract!.ClubName)
                .ThenByDescending(p => p.Rating)
                .Concat(Engine.State.Players
                    .Where(p => p.Contract == null)
                    .OrderByDescending(p => p.Rating)
                    .Take(100))
        };

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim().ToLower();
            players = players.Where(p =>
                p.Name.ToLower().Contains(term) ||
                (p.Contract?.ClubName ?? "free agent").ToLower().Contains(term));
        }

        return players.ToList();
    }
}
