@page "/results"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Results</PageTitle>

<div class="page-head">
    <div><h1>Today's Results <button class="btn btn-primary" style="margin-left:.6rem;vertical-align:middle" @onclick="@(() => Nav.NavigateTo("/game"))">Continue ⏩</button></h1><div class="subtitle">@Engine.State.DateFriendly</div></div>
</div>

@foreach (var competition in Engine.State.Competitions)
{
    var fixtures = competition.Fixtures.Where(f => f.Date == Engine.State.Date).ToList();
    if (!fixtures.Any()) continue;

    <div class="panel">
        <h2>@CompetitionHeading(competition) <span class="panel-title-sub">Round @fixtures.First().Round</span></h2>
        <table class="data fixture-table">
            <tbody>
                @foreach (var f in fixtures)
                {
                    var mine = f.HomeClub.Id == Engine.MyClub.Id || f.AwayClub.Id == Engine.MyClub.Id;
                    <tr class="@(mine ? "highlight" : "")">
                        <td style="text-align:right"><strong>@f.HomeClub.Name</strong></td>
                        <td class="center num">
                            @if (f.Concluded) { <strong>@f.GoalsHome - @f.GoalsAway</strong> } else { <span class="muted">v</span> }
                        </td>
                        <td><strong>@f.AwayClub.Name</strong></td>
                    </tr>
                    @if (f.Concluded && (f.HomeScorers.Any() || f.AwayScorers.Any()))
                    {
                        <tr>
                            <td style="text-align:right;vertical-align:top">@Scorers(f.HomeScorers)</td>
                            <td class="center muted">⚽</td>
                            <td style="vertical-align:top">@Scorers(f.AwayScorers)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private SettingsModel Settings => SettingsOptions.Value;

    private string CompetitionHeading(ICompetition competition)
    {
        var config = Settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = Settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }

    private MarkupString Scorers(List<GoalModel> scorers)
    {
        if (!scorers.Any()) return new MarkupString("");
        var grouped = scorers.GroupBy(s => s.PlayerId).Select(g =>
        {
            var name = Engine.GetPlayer(g.Key)?.Name ?? "Unknown";
            return $"{name} ({string.Join(", ", g.Select(x => $"{x.Minute}'"))})";
        });
        return new MarkupString($"<span class='muted' style='font-size:.82rem'>{string.Join("<br/>", grouped)}</span>");
    }
}
