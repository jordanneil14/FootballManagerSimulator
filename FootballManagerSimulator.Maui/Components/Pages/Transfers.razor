@page "/transfers"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Transfer List</PageTitle>

<div class="page-head">
    <div><h1>Transfer List</h1><div class="subtitle">Players available to buy</div></div>
</div>

@if (_message != null)
{
    <div class="feedback"><div class="feedback-item @(_isError ? "warn" : "")">@_message</div></div>
}

<div class="stat-row">
    <div class="stat"><div class="label">Funds Available</div><div class="value accent">@Engine.MyClub.TransferBudgetFriendly</div></div>
</div>

<div class="stat-row">
    <div class="stat">
        <div class="label">Transfer Window</div>
        <div class="value" style="font-size:1.1rem">
            @if (Engine.IsTransferWindowOpen)
            {
                <span style="color:var(--accent)">Open</span>
            }
            else
            {
                <span style="color:var(--danger)">Closed</span> <span class="muted" style="font-size:.8rem;font-weight:400">· Opens @Engine.NextTransferWindowDate.ToString("d MMM")</span>
            }
        </div>
    </div>
</div>

<div class="panel">
    <h2 class="clickable" style="cursor:pointer;user-select:none;display:flex;justify-content:space-between;align-items:center" @onclick="() => _filtersOpen = !_filtersOpen">
        Filters <span>@(_filtersOpen ? "▾" : "▸")</span>
    </h2>
    @if (_filtersOpen)
    {
        <div class="inline-form">
            <div class="field">
                <label>Name or Club</label>
                <input class="input" style="width:240px" placeholder="Search…" value="@_search" @oninput="OnSearch" />
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer">
                    <input type="checkbox" checked="@_onlyAffordable" @onchange="OnOnlyAffordableChanged" />
                    Only players within budget
                </label>
            </div>
        </div>
    }
</div>

@{
    var items = Engine.State.TransferListItems
        .Where(t => Engine.GetPlayer(t.PlayerId)?.Contract?.ClubId != Engine.MyClub.Id)
        .Where(t => !_onlyAffordable || t.AskingPrice <= Engine.MyClub.TransferBudget)
        .Select(t => new { Item = t, Player = Engine.GetPlayer(t.PlayerId) })
        .Where(x => x.Player != null)
        .OrderByDescending(x => x.Player!.Rating)
        .ToList();

    if (!string.IsNullOrWhiteSpace(_search))
    {
        var term = _search.Trim().ToLower();
        items = items.Where(x =>
            x.Player!.Name.ToLower().Contains(term) ||
            (x.Player.Contract?.ClubName ?? "").ToLower().Contains(term)).ToList();
    }

    var pageCount = Math.Max(1, (int)Math.Ceiling(items.Count / (double)PageSize));
    _page = Math.Clamp(_page, 1, pageCount);
    var pageItems = items.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
}

@if (!items.Any())
{
    <p class="muted">No players match your search. Check back after advancing a few days.</p>
}
else
{
    <div class="table-wrap">
        <table class="data">
                <thead>
                    <tr><th>Pos</th><th>Name</th><th>Club</th><th class="num">Rating</th><th class="num">Value</th><th class="num">Asking Price</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var x in pageItems)
                    {
                        var player = x.Player!;
                        var item = x.Item;
                        var affordable = item.AskingPrice <= Engine.MyClub.TransferBudget && Engine.IsTransferWindowOpen;
                        <tr>
                            <td><span class="pos-chip @Ui.PositionCssClass(player.PreferredPosition)">@player.PreferredPosition</span></td>
                            <td class="clickable" @onclick='() => Nav.NavigateTo($"/player/{player.Id}")'><strong>@player.Name</strong></td>
                            <td>@player.Contract?.ClubName</td>
                            <td class="num"><span class="@Ui.RatingCssClass(player.Rating)">@player.Rating</span></td>
                            <td class="num">@Ui.Money(Engine.GetTransferValue(player))</td>
                            <td class="num">@item.AskingPriceFriendly</td>
                            <td class="num">
                                <button class="btn btn-primary" disabled="@(!affordable)" @onclick="() => OpenBuyModal(item.PlayerId)">Buy</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    <div class="pager">
        <button class="btn" @onclick="() => _page--" disabled="@(_page <= 1)">← Prev</button>
        <span>Page @_page / @pageCount</span>
        <button class="btn" @onclick="() => _page++" disabled="@(_page >= pageCount)">Next →</button>
    </div>
}

@if (_showBuyModal && _buyPlayerId != null)
{
    var p = Engine.GetPlayer(_buyPlayerId.Value);
    <div class="modal-overlay" @onclick="() => _showBuyModal = false">
        <div class="modal" @onclick:stopPropagation>
            <h2>Sign Player</h2>
            <p><strong>@(p?.Name ?? "This player")</strong> would like to join your club.</p>
            <div style="margin-bottom:1rem">
                <label class="label">Contract Length</label>
                <select class="input" @bind="_contractYears">
                    @for (var y = 1; y <= 5; y++)
                    {
                        <option value="@y">@y @(y == 1 ? "year" : "years")</option>
                    }
                </select>
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _showBuyModal = false">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmBuy">Confirm</button>
            </div>
        </div>
    </div>
}

@code {
    private string? _message;
    private bool _isError;
    private bool _showBuyModal;
    private int? _buyPlayerId;
    private int _contractYears = 2;
    private bool _filtersOpen = true;
    private string _search = "";
    private bool _onlyAffordable = true;
    private int _page = 1;
    private const int PageSize = 20;

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnOnlyAffordableChanged(ChangeEventArgs e)
    {
        _onlyAffordable = e.Value is true;
        _page = 1;
    }

    private void OpenBuyModal(int playerId)
    {
        _buyPlayerId = playerId;
        _contractYears = 2;
        _showBuyModal = true;
    }

    private void ConfirmBuy()
    {
        if (_buyPlayerId == null) return;
        _showBuyModal = false;
        _message = Engine.BuyTransferListedPlayer(_buyPlayerId.Value, _contractYears);
        _isError = _message is not null && _message.Contains("Insufficient");
        _buyPlayerId = null;
    }
}
