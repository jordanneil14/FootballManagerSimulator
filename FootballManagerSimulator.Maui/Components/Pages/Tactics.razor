@page "/tactics"
@layout GameLayout
@inject GameEngine Engine
@inject NavigationManager Nav

<PageTitle>Tactics</PageTitle>

<div class="page-head">
    <div><h1>Tactics</h1><div class="subtitle">Formation @Engine.MyClub.Formation · click two players to swap them</div></div>
    <div class="page-actions">
        <button class="btn btn-primary" disabled="@Locked" @onclick="AutoPick">🪄 Auto Pick</button>
        <button class="btn" disabled="@Locked" @onclick="Reset">↺ Reset</button>
    </div>
</div>

@if (Locked)
{
    <div class="feedback">
        <div class="feedback-item warn">
            Your match is in progress. Make changes from the match screen.
            <a href="/match">Return to Match</a>
        </div>
    </div>
}

@{
    var slots = Engine.MyClub.TacticSlots;
    var starters = slots.Take(11).ToList();
    var subs = slots.Where(s => s.TacticSlotType == TacticSlotType.SUB).ToList();
    var reserves = slots.Where(s => s.TacticSlotType == TacticSlotType.RES && s.PlayerId != null).ToList();
    var suspendedPicked = starters.Concat(subs)
        .Select(s => s.PlayerId.HasValue ? Engine.GetPlayer(s.PlayerId.Value) : null)
        .Where(p => p is { SuspensionMatches: > 0 })
        .ToList();
}

<div class="panel" style="@LockedStyle">
    <h2>Formation</h2>
    <select class="input" value="@Engine.MyClub.Formation" disabled="@Locked" @onchange="e => ChangeFormation(e.Value?.ToString() ?? Engine.MyClub.Formation)">
        @foreach (var f in FootballManagerSimulator.Maui.Helpers.TacticHelper.Formations)
        {
            <option value="@f" selected="@(Engine.MyClub.Formation == f)">@f</option>
        }
    </select>
</div>

<TeamInstructionsPanel Disabled="@Locked" />

<div class="panel" style="@LockedStyle">
    <h2>Starting XI</h2>
    <div class="pitch">
        <div class="pitch-box-top"></div>
        <div class="pitch-box-bottom"></div>
        <div class="pitch-corner tl"></div>
        <div class="pitch-corner tr"></div>
        <div class="pitch-corner bl"></div>
        <div class="pitch-corner br"></div>
        @for (var i = 0; i < starters.Count; i++)
        {
            var slot = starters[i];
            var (x, y) = PitchLayout.Position(starters, i);
            var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
            var idx = slots.IndexOf(slot);
            var isSuspended = player is { SuspensionMatches: > 0 };
            var isInjured = player != null && player.IsInjured(Engine.State.Date);
            <div class="pitch-player @(isSuspended ? "suspended" : isInjured ? "injured" : Ui.IsOutOfPosition(player, slot.TacticSlotType) ? "out-of-position" : "")" style="left:@(x)%;top:@(y)%;cursor:pointer" @onclick="() => OnSlotClick(idx)"
                 title="@(isSuspended ? $"Suspended for {player!.SuspensionMatches} more match(es)" : isInjured ? $"{player!.InjuryDescription} — back {player.InjuryEndDate:d MMM}" : null)">
                <div class="dot" style="@(_selected == idx ? "outline:3px solid #fff" : "")">@slot.TacticSlotType</div>
                <div class="pname">@(isSuspended ? "🟥 " : isInjured ? "🤕 " : "")@(player?.Name ?? "—")</div>
            </div>
        }
    </div>

    <div class="table-wrap" style="margin-top:1.4rem">
        <table class="data">
            <tbody>
                @foreach (var slot in starters)
                {
                    @SlotRow(slot)
                }
                @foreach (var slot in subs) { @SlotRow(slot) }
                @foreach (var slot in reserves) { @SlotRow(slot) }
            </tbody>
        </table>
    </div>
</div>

@{
    var takers = Engine.PenaltyTakers();
    var startingIds = starters.Select(s => s.PlayerId).ToHashSet();
    var takingId = takers.FirstOrDefault(p => startingIds.Contains(p.Id))?.Id;
    var pickedPlayer = _selected is { } sel && slots[sel].PlayerId is { } pickedId ? Engine.GetPlayer(pickedId) : null;
}

<div class="panel" style="@LockedStyle">
    <h2>🎯 Set Pieces</h2>
    <h3 style="font-size:.9rem;margin-bottom:.4rem">Penalty Takers</h3>
    <p class="muted" style="font-size:.82rem;margin-bottom:1rem">The highest player on this list who is on the pitch takes the penalty. Tap a player above, then tap a slot to add them. Tap two takers to swap their order.</p>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th class="num">#</th><th>Pos</th><th>Player</th>
                    <th class="num" title="Finishing">Fin</th>
                    <th class="num" title="Penalties">Pen</th>
                    <th class="num" title="Composure">Com</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < takers.Count; i++)
                {
                    var index = i;
                    var taker = takers[i];
                    <tr class="clickable @(_selectedPen == index ? "highlight" : "")" @onclick="() => OnPenaltySlotClick(index)">
                        <td class="num" style="width:44px">@(index + 1)</td>
                        <td style="width:70px"><span class="pos-chip @Ui.PositionCssClass(taker.PreferredPosition)">@taker.PreferredPosition</span></td>
                        <td>
                            <strong>@taker.Name</strong>
                            @if (taker.Id == takingId)
                            {
                                <span class="tag green" style="margin-left:.4rem">⚽ Taking</span>
                            }
                        </td>
                        <td class="num" style="width:50px"><span class="@StatClass(taker.Finishing)">@taker.Finishing</span></td>
                        <td class="num" style="width:50px"><span class="@StatClass(taker.Penalties)">@taker.Penalties</span></td>
                        <td class="num" style="width:50px"><span class="@StatClass(taker.Composure)">@taker.Composure</span></td>
                        <td class="num" style="width:56px">
                            <button class="btn btn-danger" style="padding:.2rem .55rem;font-size:.8rem" title="Remove @taker.Name"
                                    disabled="@Locked" @onclick="() => RemovePenaltyTaker(index)" @onclick:stopPropagation>✕</button>
                        </td>
                    </tr>
                }
                <tr class="clickable @(_selectedPen == takers.Count ? "highlight" : "")" @onclick="() => OnPenaltySlotClick(takers.Count)">
                    <td class="num" style="width:44px">@(takers.Count + 1)</td>
                    <td colspan="6" style="font-style:italic;color:@(pickedPlayer != null ? "var(--accent)" : "var(--text-faint)")">
                        — @(pickedPlayer != null ? $"Tap to add {pickedPlayer.Name}" : "Tap a player, then tap here to add them") —
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private int? _selected;

    // Changes made here mid-match would skip the match screen's substitution rules (a reserve could
    // walk straight into the XI), so the page is read-only until the match is over.
    private bool Locked => Engine.State.MatchInProgress;
    private string LockedStyle => Locked ? "opacity:.5;pointer-events:none" : "";

    private void AutoPick()
    {
        if (!Locked) Engine.AutoPickTeam();
    }

    private void Reset()
    {
        if (!Locked) Engine.ResetTactic();
    }

    private RenderFragment SlotRow(TacticSlotModel slot)
    {
        var slots = Engine.MyClub.TacticSlots;
        var idx = slots.IndexOf(slot);
        var player = slot.PlayerId.HasValue ? Engine.GetPlayer(slot.PlayerId.Value) : null;
        var suspended = player is { SuspensionMatches: > 0 };
        var injured = player != null && player.IsInjured(Engine.State.Date);
        return @<tr class="clickable @(_selected == idx ? "highlight" : "") @(suspended ? "suspended" : injured ? "injured" : "")" @onclick="() => OnSlotClick(idx)">
            <td style="width:70px"><span class="pos-chip @Ui.PositionCssClass(slot.TacticSlotType.ToString())">@slot.TacticSlotType</span></td>
            <td>
                <span class="pname-text">@(player?.Name ?? "— empty —")</span>
                @if (suspended)
                {
                    <span class="sus-chip" title="Suspended for @player!.SuspensionMatches more match(es)">🟥 @player.SuspensionMatches</span>
                }
                else if (injured)
                {
                    <span class="inj-chip" title="@player!.InjuryDescription — back @player.InjuryEndDate?.ToString("d MMM")">🤕 @(player.InjuryEndDate!.Value.DayNumber - Engine.State.Date.DayNumber)d</span>
                }
            </td>
            <td class="num @Ui.FamiliarityCssClass(player, slot.TacticSlotType)" style="width:50px" title="@Ui.FamiliarityTitle(player, slot.TacticSlotType)">@(player != null ? player.PreferredPosition : "")</td>
            <td class="num" style="width:76px;white-space:nowrap" title="@Ui.FamiliarityTitle(player, slot.TacticSlotType)"><EffectiveRating Player="player" Slot="slot.TacticSlotType" /></td>
        </tr>;
    }

    // A penalty slot picked first: the next player tapped goes into it.
    private int? _selectedPen;

    private static string StatClass(int value) =>
        value >= 80 ? "stat-val hi" : value >= 70 ? "stat-val mid" : "stat-val";

    private void OnPenaltySlotClick(int index)
    {
        if (Locked) return;

        if (_selected is { } slotIndex)
        {
            if (Engine.MyClub.TacticSlots[slotIndex].PlayerId is { } playerId)
                Engine.SetPenaltyTaker(index, playerId);
            _selected = null;
            return;
        }

        if (_selectedPen == null) { _selectedPen = index; return; }
        if (_selectedPen != index) Engine.SwapPenaltyTakers(_selectedPen.Value, index);
        _selectedPen = null;
    }

    private void RemovePenaltyTaker(int index)
    {
        if (Locked) return;
        _selectedPen = null;
        Engine.RemovePenaltyTaker(index);
    }

    private void OnSlotClick(int index)
    {
        if (Locked) return;
        if (_selectedPen is { } penIndex)
        {
            if (Engine.MyClub.TacticSlots[index].PlayerId is { } playerId)
                Engine.SetPenaltyTaker(penIndex, playerId);
            _selectedPen = null;
            return;
        }
        if (_selected == null) { _selected = index; return; }
        if (_selected == index) { _selected = null; return; }
        Engine.SwapTacticSlots(_selected.Value, index);
        _selected = null;
    }

    private void ChangeFormation(string formation)
    {
        if (Locked) return;
        _selected = null;
        _selectedPen = null;
        Engine.ChangeFormation(formation);
    }
}
