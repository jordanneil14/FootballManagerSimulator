@page "/today"
@layout GameLayout
@inject GameEngine Engine
@inject GameActivity Activity
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Today's Fixtures</PageTitle>

@{
    var myFixture = Engine.MyFixtureToday();
    var matchInProgress = myFixture != null && myFixture.Minute > 0 && !myFixture.Concluded;
}

<div class="page-head">
    <div><h1>Match Day</h1><div class="subtitle">@Engine.State.DateFriendly</div></div>
    <div class="page-actions">
        @if (matchInProgress)
        {
            <button class="btn btn-primary btn-lg" @onclick="Resume">Resume ▶</button>
        }
        else
        {
            <button class="btn btn-primary btn-lg" @onclick="Advance">Advance ⏩</button>
        }
    </div>
</div>

@if (_error != null)
{
    <div class="feedback"><div class="feedback-item warn" style="white-space:pre-wrap;font-size:.8rem">@_error</div></div>
}

@{
    var hasFixtures = Engine.State.Competitions.Any(c => c.Fixtures.Any(f => f.Date == Engine.State.Date));
}

@if (hasFixtures)
{
    @if (matchInProgress)
    {
        <p class="muted">Match in progress. Resume to continue playing.</p>
    }
    else if (myFixture != null)
    {
        <p class="muted">You have a fixture scheduled today. Review the day's matches, then advance to play.</p>
    }
    else
    {
        <p class="muted">Fixtures are scheduled today but you're not playing. Advance to simulate them.</p>
    }
}
else
{
    <p class="muted">No fixtures scheduled today. Advance to continue.</p>
}

@foreach (var competition in Engine.State.Competitions)
{
    var fixtures = competition.Fixtures.Where(f => f.Date == Engine.State.Date).ToList();
    if (!fixtures.Any()) continue;

    <div class="fixture-block">
        <div class="fixture-block-head">@CompetitionHeading(competition) <span style="font-weight:400;color:var(--text-faint);margin-left:.5rem">Round @fixtures.First().Round</span></div>
        @foreach (var f in fixtures)
        {
            var mine = f.HomeClub.Id == Engine.State.MyClubId || f.AwayClub.Id == Engine.State.MyClubId;
            var liveMinute = matchInProgress ? (myFixture?.Minute ?? 0) : 0;
            var showLive = matchInProgress && !f.Concluded;
            var liveHome = showLive ? f.HomeScorers.Count(g => g.Minute <= liveMinute) : 0;
            var liveAway = showLive ? f.AwayScorers.Count(g => g.Minute <= liveMinute) : 0;
            <div class="fixture-row @(mine ? "mine" : "")">
                <div class="fixture-row-border"></div>
                <div class="fixture-row-inner">
                    <span class="fixture-team home">@f.HomeClub.Name</span>
                    <span class="fixture-score">
                        @if (showLive)
                        {
                            <strong>@liveHome - @liveAway</strong>
                        }
                        else if (f.Concluded)
                        {
                            <strong>@f.GoalsHome - @f.GoalsAway</strong>
                        }
                        else
                        {
                            <span class="fixture-time">@f.KickOffTime.ToString("HH:mm")</span>
                        }
                    </span>
                    <span class="fixture-team away">@f.AwayClub.Name</span>
                </div>
                @if (showLive)
                {
                    <span class="fixture-live-badge">@liveMinute'</span>
                }
            </div>
        }
    </div>
}

@code {
    private SettingsModel Settings => SettingsOptions.Value;
    private string? _error;

    private void Resume()
    {
        Nav.NavigateTo("/match");
    }

    // Runs in the background; the page holds its last render until the fixtures are done.
    protected override bool ShouldRender() => !Activity.IsBusy;

    private async Task Advance()
    {
        if (Activity.IsBusy) return;
        try
        {
            var result = await Activity.RunAsync(Engine.AdvanceTodaysFixtures);
            Nav.NavigateTo(result == GameEngine.TodaysFixturesResult.PreMatch ? "/prematch" : "/results");
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}\n{ex.StackTrace}";
        }
    }

    private string CompetitionHeading(ICompetition competition)
    {
        var config = Settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = Settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }
}
