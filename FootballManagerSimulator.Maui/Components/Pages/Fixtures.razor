@page "/fixtures"
@layout GameLayout
@inject GameEngine Engine
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Fixtures &amp; Results</PageTitle>

<div class="page-head"><div><h1>Fixtures &amp; Results</h1></div></div>

@{
    var allCompetitions = Engine.State.Competitions.ToList();

    var allDates = allCompetitions
        .SelectMany(c => c.Fixtures)
        .Select(f => f.Date)
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    var months = allDates
        .Select(d => new DateOnly(d.Year, d.Month, 1))
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    if (_selectedMonth == default && months.Any())
    {
        var currentMonth = new DateOnly(Engine.State.Date.Year, Engine.State.Date.Month, 1);
        _selectedMonth = months.Contains(currentMonth) ? currentMonth : months.First();
    }

    var dates = allDates
        .Where(d => d.Year == _selectedMonth.Year && d.Month == _selectedMonth.Month)
        .ToList();
}

<div class="league-select">
    <select class="input" value="@_selectedMonth.ToString("yyyy-MM")" @onchange="OnMonthChanged" aria-label="Month">
        @foreach (var m in months)
        {
            <option value="@m.ToString("yyyy-MM")" selected="@(m == _selectedMonth)">@m.ToString("MMMM yyyy")</option>
        }
    </select>
</div>

@foreach (var date in dates)
{
    var blocks = allCompetitions
        .Select(c => (competition: c, fixtures: c.Fixtures.Where(f => f.Date == date).ToList()))
        .Where(x => x.fixtures.Any())
        .ToList();

    foreach (var block in blocks)
    {
        <div class="panel">
            <h2>@CompetitionHeading(block.competition)
                <span class="panel-title-sub">Round @block.fixtures.First().Round · @date.ToString("dddd, dd MMM yyyy")</span>
            </h2>
            <table class="data fixture-table">
                <tbody>
                    @foreach (var fixture in block.fixtures)
                    {
                        var mine = fixture.HomeClub.Id == Engine.MyClub.Id || fixture.AwayClub.Id == Engine.MyClub.Id;
                        <tr class="@(mine ? "highlight" : "")">
                            <td style="text-align:right"><strong>@fixture.HomeClub.Name</strong></td>
                            <td class="center">
                                @if (fixture.Concluded)
                                {
                                    <strong class="num">@fixture.GoalsHome&nbsp;-&nbsp;@fixture.GoalsAway</strong>
                                }
                                else
                                {
                                    <span class="muted">@fixture.KickOffTime.ToString("HH:mm")</span>
                                }
                            </td>
                            <td><strong>@fixture.AwayClub.Name</strong></td>
                        </tr>
                        @if (fixture.Concluded && (fixture.HomeScorers.Any() || fixture.AwayScorers.Any()))
                        {
                            <tr>
                                <td style="text-align:right;vertical-align:top" class="scorer-cell">@ScorerText(fixture.HomeScorers)</td>
                                <td class="center muted">⚽</td>
                                <td style="vertical-align:top" class="scorer-cell">@ScorerText(fixture.AwayScorers)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (!dates.Any())
{
    <p class="muted">No fixtures in this month.</p>
}

@code {
    private SettingsModel Settings => SettingsOptions.Value;
    private DateOnly _selectedMonth;

    private void OnMonthChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
            _selectedMonth = parsed;
    }

    private MarkupString ScorerText(List<GoalModel> scorers)
    {
        if (!scorers.Any()) return new MarkupString("");
        var grouped = scorers.GroupBy(s => s.PlayerId)
            .Select(g =>
            {
                var name = Engine.GetPlayer(g.Key)?.Name ?? "Unknown";
                var mins = string.Join(", ", g.Select(x => $"{x.Minute}'"));
                return $"{name} ({mins})";
            });
        return new MarkupString($"<span class='muted' style='font-size:.82rem'>{string.Join("<br/>", grouped)}</span>");
    }

    private string CompetitionHeading(ICompetition competition)
    {
        var config = Settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = Settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }
}
