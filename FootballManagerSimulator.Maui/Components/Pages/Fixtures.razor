@page "/fixtures"
@layout GameLayout
@inject GameEngine Engine
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>Fixtures &amp; Results</PageTitle>

<div class="page-head"><div><h1>Fixtures &amp; Results</h1></div></div>

@{
    var allCompetitions = Engine.State.Competitions.ToList();

    var allDates = allCompetitions
        .SelectMany(c => c.Fixtures)
        .Select(f => f.Date)
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    var months = allDates
        .Select(d => new DateOnly(d.Year, d.Month, 1))
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    if (_selectedMonth == default && months.Any())
    {
        var currentMonth = new DateOnly(Engine.State.Date.Year, Engine.State.Date.Month, 1);
        _selectedMonth = months.Contains(currentMonth) ? currentMonth : months.First();
    }

    var datesInMonth = allDates
        .Where(d => d.Year == _selectedMonth.Year && d.Month == _selectedMonth.Month)
        .ToList();

    if (_selectedDate == default && datesInMonth.Any())
    {
        _selectedDate = datesInMonth.Contains(Engine.State.Date) ? Engine.State.Date : datesInMonth.First();
    }

    if (_selectedDate != default && (_selectedDate.Year != _selectedMonth.Year || _selectedDate.Month != _selectedMonth.Month))
    {
        _selectedDate = datesInMonth.Any() ? datesInMonth.First() : default;
    }
}

<!-- Month dropdown -->
<div class="league-select">
    <select class="input" value="@_selectedMonth.ToString("yyyy-MM")" @onchange="OnMonthChanged" aria-label="Month">
        @foreach (var m in months)
        {
            <option value="@m.ToString("yyyy-MM")" selected="@(m == _selectedMonth)">@m.ToString("MMMM yyyy")</option>
        }
    </select>
</div>

<!-- Day scroll tabs -->
@if (datesInMonth.Any())
{
    <div class="day-tabs" @ref="_dayTabsRef">
        @foreach (var date in datesInMonth)
        {
            var isSelected = date == _selectedDate;
            var isToday = date == Engine.State.Date;
            <button class="day-tab @(isSelected ? "active" : "") @(isToday ? "today" : "")"
                    @onclick="@(() => SelectDate(date))">
                <span class="day-tab-name">@date.ToString("ddd")</span>
                <span class="day-tab-num">@date.Day</span>
            </button>
        }
    </div>
}

<!-- Fixtures for selected day -->
@if (_selectedDate != default)
{
    var blocks = allCompetitions
        .Select(c => (competition: c, fixtures: c.Fixtures.Where(f => f.Date == _selectedDate).ToList()))
        .Where(x => x.fixtures.Any())
        .ToList();

    if (blocks.Any())
    {
        foreach (var block in blocks)
        {
            <div class="fixture-block">
                <div class="fixture-block-head">@CompetitionHeading(block.competition)</div>
                @foreach (var fixture in block.fixtures)
                {
                    var mine = fixture.HomeClub.Id == Engine.MyClub.Id || fixture.AwayClub.Id == Engine.MyClub.Id;
                    <div class="fixture-row @(mine ? "mine" : "")">
                        <div class="fixture-row-border"></div>
                        <div class="fixture-row-inner">
                            <span class="fixture-team home">@fixture.HomeClub.Name</span>
                            <span class="fixture-score">
                                @if (fixture.Concluded)
                                {
                                    <strong>@fixture.GoalsHome - @fixture.GoalsAway</strong>
                                }
                                else
                                {
                                    <span class="fixture-time">@fixture.KickOffTime.ToString("HH:mm")</span>
                                }
                            </span>
                            <span class="fixture-team away">@fixture.AwayClub.Name</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="muted" style="margin-top:1rem">No fixtures on this day.</p>
    }
}
else if (!datesInMonth.Any())
{
    <p class="muted">No fixtures in this month.</p>
}

@code {
    private SettingsModel Settings => SettingsOptions.Value;
    private DateOnly _selectedMonth;
    private DateOnly _selectedDate;
    private ElementReference _dayTabsRef;

    private void OnMonthChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _selectedMonth = parsed;
            _selectedDate = default;
        }
    }

    private void SelectDate(DateOnly date)
    {
        _selectedDate = date;
    }

    private string CompetitionHeading(ICompetition competition)
    {
        var config = Settings.Competitions.FirstOrDefault(p => p.Id == competition.Id);
        if (config == null || config.CountryId == 0) return competition.Name;
        var country = Settings.Countries.FirstOrDefault(p => p.Id == config.CountryId);
        return country != null ? $"{country.Name} - {competition.Name}" : competition.Name;
    }
}
