@page "/new"
@inject GameEngine Engine
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<SettingsModel> SettingsOptions

<PageTitle>New Game</PageTitle>

<div class="menu-card @(_step == 2 ? "wide" : "")">
    <div class="steps">
        <div class="step-dot @(_step >= 0 ? "active" : "")"></div>
        <div class="step-dot @(_step >= 1 ? "active" : "")"></div>
        <div class="step-dot @(_step >= 2 ? "active" : "")"></div>
        <div class="step-dot @(_step >= 3 ? "active" : "")"></div>
    </div>

    @if (_step == 0)
    {
        <div class="brand"><h1>Create Manager</h1><p>What should we call you, boss?</p></div>
        <EditForm Model="this" OnValidSubmit="SubmitName">
            <div class="field">
                <label>Manager name</label>
                <input class="input" value="@_managerName" @oninput="e => _managerName = e.Value?.ToString() ?? string.Empty" placeholder="e.g. Alex Ferguson" autofocus />
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit" disabled="@string.IsNullOrWhiteSpace(_managerName)">Continue</button>
        </EditForm>
    }
    else if (_step == 1)
    {
        <div class="brand"><h1>Select a League</h1><p>Choose the division you want to manage in.</p></div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>League</th></tr>
                </thead>
                <tbody>
                    @foreach (var league in Settings.Competitions.Where(p => p.IsLeague).OrderBy(p => p.Rank))
                    {
                        <tr class="clickable" @onclick="() => PickLeague(league.Id)">
                            <td><strong>@CountryFlag(league.CountryId) @league.Name</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_step == 2)
    {
        <div class="brand"><h1>Select a Club</h1><p>Pick the club to begin your career with.</p></div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Club</th></tr>
                </thead>
                <tbody>
                    @foreach (var club in Engine.GameCreator.Clubs.Where(p => p.LeagueId == _leagueId).OrderBy(p => p.Name))
                    {
                        <tr class="clickable" @onclick="() => PickClub(club.Id)">
                            <td><strong>@club.Name</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="divider"></div>
        <button class="btn btn-ghost" @onclick="() => _step = 1">← Back</button>
    }
    else if (_summaryClub != null)
    {
        <div class="brand"><h1>Summary</h1><p>Check your details before you begin.</p></div>
        <dl class="kv">
            <dt>Manager</dt><dd>@Engine.GameCreator.ManagerName</dd>
            <dt>League</dt><dd>@LeagueName(_leagueId)</dd>
            <dt>Club</dt><dd>@_summaryClub.Name</dd>
            <dt>Stadium</dt><dd>@_summaryClub.Stadium</dd>
            <dt>Transfer budget</dt><dd>@Ui.Money(_summaryClub.TransferBudget)</dd>
            <dt>Key player</dt><dd>@KeyPlayer(_summaryClub.Id)</dd>
        </dl>
        <div class="divider"></div>
        <div class="menu-actions">
            <button class="btn btn-primary btn-lg btn-block" @onclick="StartCareer">Start Career</button>
            <button class="btn btn-ghost btn-block" @onclick="() => _step = 2">← Back</button>
        </div>
    }
</div>

@code {
    private int _step;
    private string _managerName = "";
    private int _leagueId;
    private ClubModel? _summaryClub;

    private SettingsModel Settings => SettingsOptions.Value;

    protected override void OnInitialized()
    {
        // Ensure the game data has been initialised (covers a direct navigation to /new).
        if (!Engine.State.Players.Any())
            Engine.StartNewGame();
    }

    private void SubmitName()
    {
        if (string.IsNullOrWhiteSpace(_managerName)) return;
        Engine.SetManagerName(_managerName);
        _step = 1;
    }

    private void PickLeague(int leagueId)
    {
        _leagueId = leagueId;
        Engine.SelectLeague(leagueId);
        _step = 2;
    }

    private void PickClub(int clubId)
    {
        _summaryClub = Engine.GameCreator.Clubs.First(p => p.Id == clubId);
        _step = 3;
    }

    private void StartCareer()
    {
        if (_summaryClub == null) return;
        Engine.SelectClub(_summaryClub.Id);
        Nav.NavigateTo("/game");
    }

    private string LeagueName(int leagueId) =>
        Settings.Competitions.FirstOrDefault(p => p.Id == leagueId)?.Name ?? "";

    private string CountryName(int countryId) =>
        Settings.Countries.FirstOrDefault(p => p.Id == countryId)?.Name ?? "";

    private string CountryFlag(int countryId) => countryId switch
    {
        1 => "\U0001F3F4\U000E0067\U000E0062\U000E0065\U000E006E\U000E0067\U000E007F",
        2 => "\U0001F1EA\U0001F1F8",
        3 => "\U0001F1E9\U0001F1EA",
        4 => "\U0001F1EE\U0001F1F9",
        5 => "\U0001F1EB\U0001F1F7",
        6 => "\U0001F1F5\U0001F1F9",
        _ => "\U0001F3F3️"
    };

    private string KeyPlayer(int clubId) => Engine.State.Players
        .Where(p => p.Contract != null && p.Contract.ClubId == clubId)
        .OrderByDescending(p => p.Rating)
        .FirstOrDefault()?.Name ?? "—";
}
